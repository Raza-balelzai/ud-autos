@model Customer

<form asp-action="@(Model.Id > 0 ? "Edit" : "Create")" method="post" class="card-panel">
    @if (Model.Id > 0)
    {
        <input type="hidden" asp-for="Id" />
    }
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <div class="form-grid">
        <div class="field">
            <label asp-for="CustomerCode">Customer ID</label>
            <input asp-for="CustomerCode" class="input-app" placeholder="Leave blank to auto-generate" />
        </div>
        <div class="field">
            <label asp-for="Name">Name</label>
            <input asp-for="Name" class="input-app" />
            <span asp-validation-for="Name" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="ShopName">Shop Name</label>
            <input asp-for="ShopName" class="input-app" />
        </div>
        <div class="field">
            <label asp-for="Phone">Phone</label>
            <input asp-for="Phone" class="input-app" />
        </div>
        <div class="field">
            <label asp-for="City">City</label>
            <input asp-for="City" class="input-app" />
        </div>
        <div class="field">
            <label asp-for="CustomerType">Customer Type</label>
            <select asp-for="CustomerType" class="select-app" asp-items="Html.GetEnumSelectList<CustomerType>()"></select>
        </div>
        <div class="field">
            <label asp-for="CreditLimit">Credit Limit (optional)</label>
            <input asp-for="CreditLimit" class="input-app" />
        </div>
        @if (Model.Id == 0)
        {
            <div class="field">
                <label asp-for="OpeningBalance">Opening Balance (migration)</label>
                <input asp-for="OpeningBalance" class="input-app" />
                <span class="hint">Seeds current balance once. Later balances come from ledger.</span>
            </div>
        }
        <div class="field form-grid--full">
            <label asp-for="Address">Address</label>
            <textarea asp-for="Address" class="textarea-app"></textarea>
        </div>
        <div class="field form-grid--full">
            <label asp-for="Notes">Notes</label>
            <textarea asp-for="Notes" class="textarea-app"></textarea>
        </div>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn-app btn-app--primary">Save Customer</button>
        <a class="btn-app btn-app--outline" asp-action="Index">Cancel</a>
    </div>
</form>
