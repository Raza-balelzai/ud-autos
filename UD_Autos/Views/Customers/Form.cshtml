@model Customer
@{
    var isEdit = Model.Id > 0;
}

<form asp-action="@(isEdit ? "Edit" : "Create")" method="post" class="card-panel">
    @if (isEdit)
    {
        <input type="hidden" asp-for="Id" />
    }
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <p class="form-legend"><span class="req" aria-hidden="true">*</span> Required field</p>
    <h3 class="form-section__title">Customer</h3>
    <div class="form-grid">
        <div class="field">
            <label asp-for="CustomerCode">Customer ID @(isEdit ? Html.Raw("<span class=\"req\" aria-hidden=\"true\">*</span>") : null)</label>
            <input asp-for="CustomerCode" class="input-app" placeholder="@(isEdit ? "" : "Leave blank to auto-generate")" />
            @if (!isEdit)
            {
                <span class="hint">Optional — blank generates a new ID</span>
            }
        </div>
        <div class="field">
            <label asp-for="Name" class="is-required">Name <span class="req" aria-hidden="true">*</span></label>
            <input asp-for="Name" class="input-app" required aria-required="true" />
            <span asp-validation-for="Name" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="ShopName">Shop Name</label>
            <input asp-for="ShopName" class="input-app" />
        </div>
        <div class="field">
            <label asp-for="Phone">Phone</label>
            <input asp-for="Phone" class="input-app" />
        </div>
        <div class="field">
            <label asp-for="City">City</label>
            <input asp-for="City" class="input-app" />
        </div>
        <div class="field">
            <label asp-for="CustomerType" class="is-required">Customer Type <span class="req" aria-hidden="true">*</span></label>
            <select asp-for="CustomerType" class="select-app" asp-items="Html.GetEnumSelectList<CustomerType>()"></select>
        </div>
        <div class="field">
            <label asp-for="CreditLimit">Credit Limit</label>
            <input asp-for="CreditLimit" class="input-app" />
            <span class="hint">Optional</span>
        </div>
        @if (!isEdit)
        {
            <div class="field">
                <label asp-for="OpeningBalance">Opening Balance (migration)</label>
                <input asp-for="OpeningBalance" class="input-app" />
                <span class="hint">Optional — seeds balance once; later balances come from ledger</span>
            </div>
        }
        <div class="field form-grid--full">
            <label asp-for="Address">Address</label>
            <textarea asp-for="Address" class="textarea-app"></textarea>
        </div>
        <div class="field form-grid--full">
            <label asp-for="Notes">Notes</label>
            <textarea asp-for="Notes" class="textarea-app"></textarea>
        </div>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn-app btn-app--primary"><svg class="ico" aria-hidden="true"><use href="#i-check"></use></svg> Save Customer</button>
        <a class="btn-app btn-app--outline" asp-action="Index"><svg class="ico" aria-hidden="true"><use href="#i-x"></use></svg> Cancel</a>
    </div>
</form>
