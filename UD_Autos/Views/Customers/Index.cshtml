@model PagedResult<Customer>
@{
    var pager = PagerViewModel.From(Model, "Index", new { search = Model.Search, sortBy = Model.SortBy, sortDesc = Model.SortDesc });
}

@section PageActions {
    <a class="btn-app btn-app--primary" asp-action="Create"><svg class="ico" aria-hidden="true"><use href="#i-plus"></use></svg> Add customer</a>
}

<div class="card-panel">
    <form method="get" class="table-toolbar">
        <input class="input-app" type="search" name="search" value="@Model.Search" placeholder="Search code, name, shop, phone, city..." />
        <select class="select-app" name="type">
            <option value="">All types</option>
            <option value="Wholesale">Wholesale</option>
            <option value="Retail">Retail</option>
        </select>
        <select class="select-app" name="sortBy">
            <option value="name">Name</option>
            <option value="code">Code</option>
            <option value="balance">Balance</option>
            <option value="city">City</option>
        </select>
        <button type="submit" class="btn-app btn-app--outline"><svg class="ico" aria-hidden="true"><use href="#i-filter"></use></svg> Filter</button>
    </form>

    <div class="table-wrap">
        <table class="table-app">
            <thead>
            <tr>
                <th>Customer ID</th>
                <th>Name / Shop</th>
                <th>Phone</th>
                <th>City</th>
                <th>Type</th>
                <th>Balance</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="7"><div class="empty-state">No customers yet.</div></td></tr>
            }
            else
            {
                foreach (var c in Model.Items)
                {
                    <tr>
                        <td>@c.CustomerCode</td>
                        <td>@c.Name @(string.IsNullOrEmpty(c.ShopName) ? "" : $"({c.ShopName})")</td>
                        <td>@(c.Phone ?? "—")</td>
                        <td>@(c.City ?? "—")</td>
                        <td><span class="badge-app badge-app--primary">@c.CustomerType</span></td>
                        <td>Rs. @c.CurrentBalance.ToString("N2")</td>
                        <td class="actions">
                            <a class="btn-app btn-app--primary btn-app--icon" asp-action="Details" asp-route-id="@c.Id" title="View" aria-label="View"><svg class="ico" aria-hidden="true"><use href="#i-eye"></use></svg></a>
                            <a class="btn-app btn-app--outline btn-app--icon" asp-action="Khata" asp-route-id="@c.Id" title="Khata" aria-label="Khata"><svg class="ico" aria-hidden="true"><use href="#i-book"></use></svg></a>
                            <a class="btn-app btn-app--success btn-app--icon" asp-action="Edit" asp-route-id="@c.Id" title="Edit" aria-label="Edit"><svg class="ico" aria-hidden="true"><use href="#i-pencil"></use></svg></a>
                            <form asp-action="Delete" method="post" class="row-action">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@c.Id" />
                                <button type="submit" class="btn-app btn-app--danger btn-app--icon" title="Deactivate" aria-label="Deactivate" onclick="return confirm('Deactivate this customer?');"><svg class="ico" aria-hidden="true"><use href="#i-ban"></use></svg></button>
                            </form>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="pager" />
</div>
