@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="error-page">
    <div class="card-panel error-page__card">
        <h1>Something went wrong</h1>
        <p>This action could not be completed. Nothing else on the page was changed. Go back and try again.</p>
        @if (Model.ShowRequestId)
        {
            <p class="error-page__id">Reference <code>@Model.RequestId</code></p>
        }
        <div class="form-actions">
            <a class="btn-app btn-app--primary" asp-controller="Dashboard" asp-action="Index">
                <svg class="ico" aria-hidden="true"><use href="#i-arrow-left"></use></svg> Back to dashboard
            </a>
        </div>
    </div>
</div>
