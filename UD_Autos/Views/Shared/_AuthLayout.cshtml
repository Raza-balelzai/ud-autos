<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Auto Parts Business</title>
    <link rel="icon" type="image/png" href="~/assets/auto_parts_gear_logo_32.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
<partial name="_IconSprite" />
<div class="login-page">
    <section class="login-hero" aria-label="Auto Parts Business Solution">
        <img class="login-hero__logo" src="~/assets/Glossy Auto Parts Gear Logo.png" alt="Auto Parts Business Solution" />
        <span class="login-hero__rule" aria-hidden="true"></span>
        <div class="login-hero__body">
            <h1>Complete Management<br />for Your <span>Auto Parts</span> Business</h1>
            <p>Manage products, purchases, shipments, inventory, sales, customers and more — all in one place.</p>
            <ul class="login-features">
                <li>
                    <span class="login-feature__icon" aria-hidden="true"><svg class="ico"><use href="#i-box"></use></svg></span>
                    <span><strong>Product &amp; Inventory</strong><small>Keep track of all your auto parts</small></span>
                </li>
                <li>
                    <span class="login-feature__icon" aria-hidden="true"><svg class="ico"><use href="#i-truck"></use></svg></span>
                    <span><strong>Purchases &amp; Shipments</strong><small>Manage China purchases and shipments</small></span>
                </li>
                <li>
                    <span class="login-feature__icon" aria-hidden="true"><svg class="ico"><use href="#i-receipt"></use></svg></span>
                    <span><strong>Sales &amp; Billing</strong><small>Handle customers and khata</small></span>
                </li>
                <li>
                    <span class="login-feature__icon" aria-hidden="true"><svg class="ico"><use href="#i-activity"></use></svg></span>
                    <span><strong>Reports &amp; Insights</strong><small>Make better business decisions</small></span>
                </li>
            </ul>
        </div>
        <ul class="login-trust">
            <li>
                <span class="login-trust__icon" aria-hidden="true"><svg class="ico"><use href="#i-shield"></use></svg></span>
                <span><strong>Secure</strong><small>Your data is protected</small></span>
            </li>
            <li>
                <span class="login-trust__icon" aria-hidden="true"><svg class="ico"><use href="#i-cloud"></use></svg></span>
                <span><strong>Reliable</strong><small>Always available</small></span>
            </li>
            <li>
                <span class="login-trust__icon" aria-hidden="true"><svg class="ico"><use href="#i-bolt"></use></svg></span>
                <span><strong>Fast</strong><small>Built for your business</small></span>
            </li>
        </ul>
    </section>

    <section class="login-aside">
        <div class="login-lang">
            <svg class="ico" aria-hidden="true"><use href="#i-globe"></use></svg>
            English
        </div>
        <div class="login-card">
            <div class="login-card__brand">
                <img src="~/assets/auto_parts_gear_logo_256.png" alt="" width="48" height="48" />
                <div class="login-card__name">AUTO PARTS<span>BUSINESS SOLUTION</span></div>
            </div>
            @RenderBody()
        </div>
    </section>
</div>
<script>
    (function () {
        document.querySelectorAll("[data-toggle-password]").forEach(function (toggle) {
            toggle.addEventListener("click", function () {
                var input = document.getElementById(toggle.getAttribute("data-toggle-password"));
                if (!input) return;
                var show = input.type === "password";
                input.type = show ? "text" : "password";
                toggle.setAttribute("aria-pressed", show ? "true" : "false");
                toggle.setAttribute("aria-label", show ? "Hide password" : "Show password");
            });
        });
    })();
</script>
</body>
</html>
