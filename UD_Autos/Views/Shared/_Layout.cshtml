@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using UD_Autos.Authorization
@using UD_Autos.Models.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string NavClass(string ctrl, string? act = null)
        => string.Equals(controller, ctrl, StringComparison.OrdinalIgnoreCase)
           && (act is null || string.Equals(action, act, StringComparison.OrdinalIgnoreCase))
            ? "app-nav__link is-active"
            : "app-nav__link";

    ApplicationUser? currentUser = null;
    string displayName = "User";
    string roleLabel = "";
    if (SignInManager.IsSignedIn(User))
    {
        currentUser = await UserManager.GetUserAsync(User);
        displayName = currentUser?.FullName ?? User.Identity?.Name ?? "User";
        var roles = await UserManager.GetRolesAsync(currentUser!);
        roleLabel = roles.FirstOrDefault() ?? "";
    }
    var initials = string.Concat(displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0])).ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Auto Parts Business</title>
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
@if (SignInManager.IsSignedIn(User))
{
    <div class="app-shell">
        <aside class="app-sidebar">
            <div class="app-brand">
                <div class="app-brand__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9 17 7M7 17l-2.1 2.1"/></svg>
                </div>
                <div class="app-brand__text">Auto Parts<br/>Business Solution</div>
            </div>
            <nav class="app-nav" aria-label="Main">
                <a class="@NavClass("Dashboard")" asp-controller="Dashboard" asp-action="Index">
                    <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>
                    Dashboard
                </a>
                <a class="@NavClass("Products")" asp-controller="Products" asp-action="Index">
                    <svg viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M3.3 7 12 12l8.7-5M12 22V12"/></svg>
                    Products
                </a>
                @if (User.IsInRole(AppRoles.Owner) || User.IsInRole(AppRoles.Manager))
                {
                    <a class="@NavClass("PurchaseOrders")" asp-controller="PurchaseOrders" asp-action="Index">
                        <svg viewBox="0 0 24 24"><path d="M6 2h12v4H6zM4 6h16l-1 14H5L4 6z"/><path d="M9 10h6"/></svg>
                        China Purchases
                    </a>
                    <a class="@NavClass("HawalaPayments")" asp-controller="HawalaPayments" asp-action="Index">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M9 10h4.5a2 2 0 0 1 0 4H9"/></svg>
                        Hawala Payments
                    </a>
                    <a class="@NavClass("Shipments")" asp-controller="Shipments" asp-action="Index">
                        <svg viewBox="0 0 24 24"><path d="M3 17h13V7H3z"/><path d="M16 10h4l2 3v4h-6"/><circle cx="7.5" cy="17.5" r="1.5"/><circle cx="17.5" cy="17.5" r="1.5"/></svg>
                        Shipments
                    </a>
                    <a class="@NavClass("Inventory")" asp-controller="Inventory" asp-action="Index">
                        <svg viewBox="0 0 24 24"><path d="M4 7h16v12H4z"/><path d="M8 7V5h8v2"/></svg>
                        Inventory
                    </a>
                }
                <a class="@NavClass("Sales")" asp-controller="Sales" asp-action="Index">
                    <svg viewBox="0 0 24 24"><path d="M4 7h16v12H4z"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M9 12h6"/></svg>
                    Sales / Billing
                </a>
                <a class="@NavClass("Customers")" asp-controller="Customers" asp-action="Index">
                    <svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    Customers / Khata
                </a>
                @if (User.IsInRole(AppRoles.Owner) || User.IsInRole(AppRoles.Manager) || User.IsInRole(AppRoles.Accountant))
                {
                    <a class="@NavClass("Payments")" asp-controller="Payments" asp-action="Index">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M9 10h4.5a2 2 0 0 1 0 4H9"/></svg>
                        Receive Payment
                    </a>
                    <a class="@NavClass("Payments", "Aging")" asp-controller="Payments" asp-action="Aging">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                        Aging
                    </a>
                }
                @if (User.IsInRole(AppRoles.Owner) || User.IsInRole(AppRoles.Manager) || User.IsInRole(AppRoles.Accountant))
                {
                    <a class="@NavClass("CashBank")" asp-controller="CashBank" asp-action="Index">
                        <svg viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M2 10h20"/><circle cx="12" cy="14" r="2"/></svg>
                        Cash &amp; Bank
                    </a>
                }
                @if (User.IsInRole(AppRoles.Owner) || User.IsInRole(AppRoles.Accountant))
                {
                    <a class="@NavClass("Expenses")" asp-controller="Expenses" asp-action="Index">
                        <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h6"/></svg>
                        Expenses
                    </a>
                }
                @if (User.IsInRole(AppRoles.Owner) || User.IsInRole(AppRoles.Manager) || User.IsInRole(AppRoles.Accountant))
                {
                    <a class="@NavClass("Reports")" asp-controller="Reports" asp-action="Index">
                        <svg viewBox="0 0 24 24"><path d="M4 19V5"/><path d="M4 19h16"/><path d="M8 16v-5"/><path d="M12 16V8"/><path d="M16 16v-3"/></svg>
                        Reports
                    </a>
                }
                @if (User.IsInRole(AppRoles.Owner) || User.IsInRole(AppRoles.Manager))
                {
                    <a class="@NavClass("Suppliers")" asp-controller="Suppliers" asp-action="Index">
                        <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>
                        Suppliers
                    </a>
                }
                @if (User.IsInRole(AppRoles.Owner))
                {
                    <a class="@NavClass("Users")" asp-controller="Users" asp-action="Index">
                        <svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        Users
                    </a>
                    <a class="@NavClass("AuditLogs")" asp-controller="AuditLogs" asp-action="Index">
                        <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M12 18v-6M9 15h6"/></svg>
                        Audit Log
                    </a>
                    <a class="@NavClass("Settings")" asp-controller="Settings" asp-action="Index">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9c.3.6.9 1 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>
                        Settings
                    </a>
                }
            </nav>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <div class="app-search" data-global-search>
                    <svg class="app-search__icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                    <input id="global-search-input" type="search" placeholder="Search products, customers, invoices, shipments..." aria-label="Global search" autocomplete="off" />
                    <div class="app-dropdown app-dropdown--search" id="global-search-results" hidden role="listbox" aria-label="Search results"></div>
                </div>
                <div class="app-topbar__actions">
                    @await Component.InvokeAsync("Alerts")
                    <div class="app-user">
                        <div class="app-user__avatar">@initials</div>
                        <div class="app-user__meta">
                            <span class="app-user__name">@displayName</span>
                            <span class="app-user__role">@roleLabel</span>
                        </div>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-app btn-app--ghost btn-app--sm">Logout</button>
                        </form>
                    </div>
                </div>
            </header>

            <main class="app-content">
                @if (TempData["Success"] is string success)
                {
                    <div class="alert-app alert-app--success">@success</div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert-app alert-app--danger">@error</div>
                }

                <div class="page-header">
                    <div class="page-header__titles">
                        <h1>@ViewData["Title"]</h1>
                        @if (ViewData["Subtitle"] is string subtitle)
                        {
                            <p>@subtitle</p>
                        }
                    </div>
                    <div class="page-header__actions">
                        @await RenderSectionAsync("PageActions", required: false)
                    </div>
                </div>

                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    @RenderBody()
}

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
