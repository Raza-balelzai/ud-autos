@model PagedResult<Invoice>
@{
    var pager = PagerViewModel.From(Model, "Index", new { search = Model.Search });
}

@section PageActions {
    <a class="btn-app btn-app--outline" asp-action="Daily"><svg class="ico" aria-hidden="true"><use href="#i-calendar"></use></svg> Daily sales</a>
    <a class="btn-app btn-app--primary" asp-action="Create"><svg class="ico" aria-hidden="true"><use href="#i-plus"></use></svg> New invoice</a>
}

<div class="card-panel">
    <form method="get" class="table-toolbar">
        <input class="input-app" name="search" value="@Model.Search" placeholder="Search invoice / customer..." />
        <input class="input-app" type="date" name="from" />
        <input class="input-app" type="date" name="to" />
        <button type="submit" class="btn-app btn-app--outline"><svg class="ico" aria-hidden="true"><use href="#i-filter"></use></svg> Filter</button>
    </form>
    <div class="table-wrap">
        <table class="table-app">
            <thead>
            <tr>
                <th>Invoice</th>
                <th>Date</th>
                <th>Customer</th>
                <th>Mode</th>
                <th>Total</th>
                <th>Paid</th>
                <th>Outstanding</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="8"><div class="empty-state">No invoices yet.</div></td></tr>
            }
            else
            {
                foreach (var inv in Model.Items)
                {
                    <tr>
                        <td>@inv.InvoiceNumber</td>
                        <td>@inv.InvoiceDate.ToString("dd MMM yyyy")</td>
                        <td>@(inv.Customer.ShopName ?? inv.Customer.Name)</td>
                        <td><span class="badge-app badge-app--primary">@inv.PaymentMode</span></td>
                        <td>Rs. @inv.BillTotal.ToString("N2")</td>
                        <td>Rs. @inv.PaymentReceived.ToString("N2")</td>
                        <td>Rs. @inv.OutstandingAmount.ToString("N2")</td>
                        <td class="actions">
                            <a class="btn-app btn-app--primary btn-app--icon" asp-action="Details" asp-route-id="@inv.Id" title="View" aria-label="View"><svg class="ico" aria-hidden="true"><use href="#i-eye"></use></svg></a>
                            <a class="btn-app btn-app--outline btn-app--icon" asp-action="Print" asp-route-id="@inv.Id" target="_blank" title="Print" aria-label="Print"><svg class="ico" aria-hidden="true"><use href="#i-printer"></use></svg></a>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="pager" />
</div>
