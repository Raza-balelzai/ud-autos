@model BillingPageViewModel
@{
    string SaleOption(Product p) => p.ProductKind == ProductKind.CompleteSet
        ? $"{p.Sku} — {p.Name} (Complete set, {(p.VirtualAvailableSets ?? 0):N0} available)"
        : $"{p.Sku} — {p.Name}";
}

<form asp-action="Create" method="post" class="card-panel" id="billing-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="IdempotencyKey" />
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <p class="form-legend"><span class="req" aria-hidden="true">*</span> Required field</p>

    <section class="form-section form-section--first">
        <div class="form-section__head">
            <h3 class="form-section__title">Sale</h3>
        </div>
    <div class="form-grid form-grid--3">
        <div class="field">
            <label class="is-required">Customer <span class="req" aria-hidden="true">*</span></label>
            <select asp-for="CustomerId" class="select-app" id="customer-select" asp-items="@(new SelectList(Model.Customers.Select(c => new { c.Id, Label = (c.ShopName ?? c.Name) + " (" + c.Phone + ")" }), "Id", "Label"))" required>
                <option value="">— Search / select —</option>
            </select>
        </div>
        <div class="field">
            <label class="is-required">Invoice Date <span class="req" aria-hidden="true">*</span></label>
            <input asp-for="InvoiceDate" type="date" class="input-app" required />
        </div>
        <div class="field">
            <label>Invoice No</label>
            <input class="input-app" value="Auto on save" readonly />
            <span class="hint">Auto-generated</span>
        </div>
    </div>
        <div class="detail-grid" id="customer-info">
            <div class="detail-item"><dt>Previous balance</dt><dd id="cust-balance">Rs. @(Model.Customer?.CurrentBalance.ToString("N2") ?? "—")</dd></div>
            <div class="detail-item"><dt>Credit limit</dt><dd id="cust-limit">@(Model.Customer?.CreditLimit is decimal lim ? $"Rs. {lim:N2}" : "—")</dd></div>
            <div class="detail-item"><dt>Customer type</dt><dd id="cust-type">@(Model.Customer?.CustomerType.ToString() ?? "—")</dd></div>
        </div>
    </section>

    <section class="form-section">
        <div class="form-section__head">
            <h3 class="form-section__title">Line items</h3>
        </div>
    <div class="table-toolbar">
        <input class="input-app" id="product-search" placeholder="Filter products by SKU or name" autocomplete="off" />
    </div>
    <div class="line-head" aria-hidden="true"><span>Product</span><span>Quantity</span><span>Unit price</span><span>Discount</span><span></span></div>
    <div class="line-items-editor" id="sale-lines">
        @for (var i = 0; i < Model.Items.Count; i++)
        {
            <div class="line-row">
                <select class="select-app" name="Items[@i].ProductId" asp-items="@(new SelectList(Model.Products.Select(p => new { p.Id, Label = SaleOption(p) }), "Id", "Label", Model.Items[i].ProductId))">
                    <option value="">Product</option>
                </select>
                <input class="input-app" name="Items[@i].Quantity" value="@Model.Items[i].Quantity" placeholder="Quantity" aria-label="Quantity" />
                <input class="input-app" name="Items[@i].UnitPrice" value="@Model.Items[i].UnitPrice" placeholder="Unit price" aria-label="Unit price" />
                <input class="input-app" name="Items[@i].LineDiscount" value="@Model.Items[i].LineDiscount" placeholder="Discount" aria-label="Discount" />
                <button type="button" class="btn-app btn-app--ghost btn-app--icon" data-remove-line title="Remove line" aria-label="Remove line"><svg class="ico" aria-hidden="true"><use href="#i-x"></use></svg></button>
                <p class="hint line-row__note" data-layer-note hidden></p>
            </div>
        }
    </div>
    <button type="button" class="btn-app btn-app--outline btn-app--sm" id="add-sale-line"><svg class="ico" aria-hidden="true"><use href="#i-plus"></use></svg> Add line</button>
    </section>

    <section class="form-section">
        <div class="form-section__head">
            <h3 class="form-section__title">Charges and payment</h3>
        </div>
    <div class="form-grid form-grid--3">
        <div class="field">
            <label>Bill discount</label>
            <input asp-for="DiscountAmount" class="input-app" />
            <span class="hint">Optional</span>
        </div>
        <div class="field">
            <label>Delivery charge</label>
            <input asp-for="DeliveryCharge" class="input-app" />
            <span class="hint">Optional</span>
        </div>
        <div class="field">
            <label>Other charge</label>
            <input asp-for="OtherCharge" class="input-app" />
            <span class="hint">Optional</span>
        </div>
        <div class="field">
            <label class="is-required">Payment mode <span class="req" aria-hidden="true">*</span></label>
            <select asp-for="PaymentMode" class="select-app" asp-items="Html.GetEnumSelectList<PaymentMode>()" id="pay-mode"></select>
        </div>
        <div class="field">
            <label>Cash / Bank</label>
            <select asp-for="PaymentAccount" class="select-app" asp-items="Html.GetEnumSelectList<PaymentAccount>()"></select>
        </div>
        <div class="field">
            <label>Payment received (partial)</label>
            <input asp-for="PaymentReceived" class="input-app" />
            <span class="hint">Optional for credit / partial</span>
        </div>
        <div class="field">
            <label>Payment reference</label>
            <input asp-for="PaymentReference" class="input-app" />
            <span class="hint">Optional</span>
        </div>
        <div class="field form-grid--full">
            <label>Notes</label>
            <textarea asp-for="Notes" class="textarea-app"></textarea>
        </div>
    </div>
    </section>

    <div class="form-actions">
        <button type="submit" class="btn-app btn-app--success" id="save-invoice"><svg class="ico" aria-hidden="true"><use href="#i-check"></use></svg> Save invoice</button>
        <a class="btn-app btn-app--outline" asp-action="Index"><svg class="ico" aria-hidden="true"><use href="#i-x"></use></svg> Cancel</a>
    </div>
</form>

<template id="sale-line-template">
    <div class="line-row">
        <select class="select-app" name="Items[__i__].ProductId">
            <option value="">Product</option>
            @foreach (var p in Model.Products)
            {
                <option value="@p.Id" data-price="@p.WholesalePrice">@SaleOption(p)</option>
            }
        </select>
        <input class="input-app" name="Items[__i__].Quantity" placeholder="Quantity" aria-label="Quantity" />
        <input class="input-app" name="Items[__i__].UnitPrice" placeholder="Unit price" aria-label="Unit price" />
        <input class="input-app" name="Items[__i__].LineDiscount" placeholder="Discount" aria-label="Discount" />
        <button type="button" class="btn-app btn-app--ghost btn-app--icon" data-remove-line title="Remove line" aria-label="Remove line"><svg class="ico" aria-hidden="true"><use href="#i-x"></use></svg></button>
        <p class="hint line-row__note" data-layer-note hidden></p>
    </div>
</template>

@section Scripts {
<script>
(() => {
  const lines = document.getElementById('sale-lines');
  const tpl = document.getElementById('sale-line-template');
  const search = document.getElementById('product-search');
  const prices = {};
  tpl?.querySelectorAll('option[data-price]').forEach(option => { prices[option.value] = option.dataset.price; });

  function applyFilter() {
    const query = (search?.value || '').trim().toLowerCase();
    lines?.querySelectorAll('select').forEach(select => {
      [...select.options].forEach(option => {
        if (!option.value) return;
        const matches = !query || option.textContent.toLowerCase().includes(query);
        option.hidden = !matches && option.value !== select.value;
      });
    });
  }

  document.getElementById('add-sale-line')?.addEventListener('click', () => {
    const i = lines.querySelectorAll('.line-row').length;
    lines.insertAdjacentHTML('beforeend', tpl.innerHTML.replaceAll('__i__', i));
    applyFilter();
    refreshLayerNotes();
  });
  search?.addEventListener('input', applyFilter);
  const layerCache = {};

  function qtyText(value) {
    const n = Number(value);
    if (!Number.isFinite(n)) return '0';
    return Math.abs(n - Math.round(n)) < 0.0000001 ? String(Math.round(n)) : String(Math.round(n * 100) / 100);
  }

  function moneyText(value) {
    const n = Number(value);
    const whole = Math.abs(n - Math.round(n)) < 0.0000001;
    return n.toLocaleString('en-US', { minimumFractionDigits: whole ? 0 : 2, maximumFractionDigits: whole ? 0 : 2 });
  }

  function joinParts(parts) {
    if (parts.length <= 1) return parts[0] || '';
    if (parts.length === 2) return parts[0] + ' and ' + parts[1];
    return parts.slice(0, -1).join(', ') + ', and ' + parts[parts.length - 1];
  }

  function planLayers(layers, quantity, skip) {
    let remainingSkip = Math.max(0, Number(skip) || 0);
    let remaining = quantity;
    const slices = [];
    let oldest = 0;
    for (const layer of layers) {
      let available = Number(layer.available) || 0;
      if (available <= 0) continue;
      if (remainingSkip > 0) {
        const skipped = Math.min(available, remainingSkip);
        available -= skipped;
        remainingSkip -= skipped;
      }
      if (available <= 0) continue;
      if (oldest === 0) oldest = available;
      if (remaining <= 0) continue;
      const take = Math.min(available, remaining);
      slices.push({ quantity: take, unitCost: layer.unitCost });
      remaining -= take;
    }
    return { slices, oldest };
  }

  function describeLayers(slices, oldest, includeCost) {
    if (!slices.length) return '';
    if (slices.length === 1) {
      const left = oldest > 0 ? oldest : slices[0].quantity;
      const text = 'Oldest stock: ' + qtyText(left) + ' left.';
      return includeCost ? text + ' Cost Rs ' + moneyText(slices[0].unitCost) + '.' : text;
    }
    const parts = includeCost
      ? slices.map(s => qtyText(s.quantity) + ' at Rs ' + moneyText(s.unitCost))
      : slices.map(s => qtyText(s.quantity));
    return 'This quantity uses ' + joinParts(parts) + '. Add a second line if those should have different sale prices.';
  }

  function layersFor(productId) {
    if (!layerCache[productId]) {
      layerCache[productId] = fetch('/Sales/OpenLayers?productId=' + encodeURIComponent(productId))
        .then(res => res.ok ? res.json() : { isSet: false, includeCost: false, layers: [] });
    }
    return layerCache[productId];
  }

  async function refreshLayerNotes() {
    const rows = [...lines.querySelectorAll('.line-row')];
    const used = {};
    for (const row of rows) {
      const note = row.querySelector('[data-layer-note]');
      const productId = row.querySelector('select')?.value;
      const quantity = Number(row.querySelector('input[name$=".Quantity"]')?.value);
      if (!note) continue;
      if (!productId || !(quantity > 0)) {
        note.hidden = true;
        note.textContent = '';
        continue;
      }
      const data = await layersFor(productId);
      if (data.isSet) {
        note.hidden = false;
        note.textContent = 'The set price is for the whole set. Item stock comes from the oldest receipts.';
        continue;
      }
      const skip = used[productId] || 0;
      const planned = planLayers(data.layers || [], quantity, skip);
      used[productId] = skip + quantity;
      const text = describeLayers(planned.slices, planned.oldest, !!data.includeCost);
      note.hidden = !text;
      note.textContent = text;
    }
  }

  lines?.addEventListener('change', (e) => {
    const select = e.target.closest('select');
    if (select && prices[select.value] != null) {
      const price = select.closest('.line-row')?.querySelector('input[name$=".UnitPrice"]');
      if (price) price.value = prices[select.value];
    }
    refreshLayerNotes();
  });
  lines?.addEventListener('input', (e) => {
    if (e.target.matches('input[name$=".Quantity"]')) refreshLayerNotes();
  });
  lines?.addEventListener('click', e => {
    const btn = e.target.closest('[data-remove-line]');
    if (btn && lines.querySelectorAll('.line-row').length > 1) {
      btn.closest('.line-row').remove();
      refreshLayerNotes();
    }
  });
  refreshLayerNotes();
  document.getElementById('customer-select')?.addEventListener('change', async (e) => {
    const id = e.target.value;
    if (!id) return;
    const res = await fetch(`/Sales/CustomerInfo?id=${id}`);
    if (!res.ok) return;
    const c = await res.json();
    document.getElementById('cust-balance').textContent = `Rs. ${Number(c.currentBalance).toFixed(2)}`;
    document.getElementById('cust-limit').textContent = c.creditLimit != null ? `Rs. ${Number(c.creditLimit).toFixed(2)}` : '—';
    document.getElementById('cust-type').textContent = c.customerType === 1 ? 'Wholesale' : 'Retail';
  });
  let submitting = false;
  document.getElementById('billing-form')?.addEventListener('submit', () => {
    if (submitting) return false;
    submitting = true;
    document.getElementById('save-invoice').disabled = true;
  });
})();
</script>
}
