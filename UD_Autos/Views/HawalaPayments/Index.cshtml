@model PagedResult<HawalaPayment>
@{
    var pager = PagerViewModel.From(Model, "Index", new
    {
        search = Model.Search,
        supplierId = Context.Request.Query["supplierId"].ToString(),
        from = Context.Request.Query["from"].ToString(),
        to = Context.Request.Query["to"].ToString()
    });
}

@section PageActions {
    <a class="btn-app btn-app--primary" asp-action="Create"><svg class="ico" aria-hidden="true"><use href="#i-plus"></use></svg> New hawala payment</a>
}

<div class="card-panel">
    <form method="get" class="table-toolbar">
        <input class="input-app" name="search" value="@Model.Search" placeholder="Search payment / person / supplier..." />
        <select class="select-app" name="supplierId" asp-items="ViewBag.Suppliers"><option value="">All suppliers</option></select>
        <input class="input-app" type="date" name="from" value="@((ViewBag.From as DateTime?)?.ToString("yyyy-MM-dd"))" />
        <input class="input-app" type="date" name="to" value="@((ViewBag.To as DateTime?)?.ToString("yyyy-MM-dd"))" />
        <button type="submit" class="btn-app btn-app--outline"><svg class="ico" aria-hidden="true"><use href="#i-filter"></use></svg> Filter</button>
    </form>

    <div class="table-wrap">
        <table class="table-app">
            <thead>
            <tr>
                <th>No</th>
                <th>Date</th>
                <th>Hawala Person</th>
                <th>Supplier</th>
                <th>PO</th>
                <th>RMB Recv</th>
                <th>PKR Paid</th>
                <th>Eff. Rate</th>
                <th>Fee</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="10"><div class="empty-state">No Hawala payments yet.</div></td></tr>
            }
            else
            {
                foreach (var h in Model.Items)
                {
                    <tr>
                        <td>@h.PaymentNumber</td>
                        <td>@h.PaymentDate.ToString("dd MMM yyyy")</td>
                        <td>@h.HawalaPerson</td>
                        <td>@h.Supplier.Name</td>
                        <td>@(h.PurchaseOrder?.PoNumber ?? "—")</td>
                        <td>¥ @h.RmbReceived.ToString("N2")</td>
                        <td>Rs. @h.PkrPaid.ToString("N2")</td>
                        <td>@h.EffectiveRmbRate.ToString("N4")</td>
                        <td>Rs. @h.HawalaFee.ToString("N2")</td>
                        <td class="actions">
                            <a class="btn-app btn-app--primary btn-app--icon" asp-action="Details" asp-route-id="@h.Id" title="View" aria-label="View"><svg class="ico" aria-hidden="true"><use href="#i-eye"></use></svg></a>
                            <a class="btn-app btn-app--success btn-app--icon" asp-action="Edit" asp-route-id="@h.Id" title="Edit" aria-label="Edit"><svg class="ico" aria-hidden="true"><use href="#i-pencil"></use></svg></a>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="pager" />
</div>
