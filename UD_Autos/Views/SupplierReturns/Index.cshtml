@model PagedResult<UD_Autos.Models.Inventory.SupplierReturn>
@{
    var suppliers = ViewBag.Suppliers as IReadOnlyList<UD_Autos.Models.Suppliers.Supplier> ?? Array.Empty<UD_Autos.Models.Suppliers.Supplier>();
    var pager = PagerViewModel.From(Model, "Index", new { search = Model.Search, supplierId = ViewBag.SupplierId });
}

@section PageActions {
    <a class="btn-app btn-app--primary" asp-action="Create">+ Supplier return</a>
}

<div class="card-panel">
    <form method="get" class="table-toolbar">
        <input class="input-app" name="search" value="@Model.Search" placeholder="Search return / supplier / reason..." />
        <select class="select-app" name="supplierId" asp-items="@(new SelectList(suppliers, "Id", "Name", ViewBag.SupplierId))">
            <option value="">All suppliers</option>
        </select>
        <button type="submit" class="btn-app btn-app--outline">Filter</button>
    </form>

    <div class="table-wrap">
        <table class="table-app">
            <thead>
            <tr>
                <th>Return #</th>
                <th>Date</th>
                <th>Supplier</th>
                <th>Qty</th>
                <th>Reason</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="6"><div class="empty-state">No supplier returns yet.</div></td></tr>
            }
            else
            {
                foreach (var r in Model.Items)
                {
                    <tr>
                        <td>@r.ReturnNumber</td>
                        <td>@r.ReturnDate.ToString("dd MMM yyyy")</td>
                        <td>@r.Supplier.Name</td>
                        <td>@r.TotalQuantity.ToString("N2")</td>
                        <td>@r.Reason</td>
                        <td><a class="btn-app btn-app--outline btn-app--sm" asp-action="Details" asp-route-id="@r.Id">Open</a></td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="pager" />
</div>
