@model Supplier
@{
    var isEdit = Model.Id > 0;
}

<form asp-action="@(isEdit ? "Edit" : "Create")" method="post" class="card-panel">
    @if (isEdit)
    {
        <input type="hidden" asp-for="Id" />
    }
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <p class="form-legend"><span class="req" aria-hidden="true">*</span> Required field</p>
    <h3 class="form-section__title">Supplier</h3>
    <div class="form-grid">
        <div class="field">
            <label asp-for="SupplierCode">Supplier Code @(isEdit ? Html.Raw("<span class=\"req\" aria-hidden=\"true\">*</span>") : null)</label>
            <input asp-for="SupplierCode" class="input-app" placeholder="@(isEdit ? "" : "Leave blank to auto-generate")" />
            @if (!isEdit)
            {
                <span class="hint">Optional — blank generates a new code</span>
            }
        </div>
        <div class="field">
            <label asp-for="Name" class="is-required">Factory / Supplier Name <span class="req" aria-hidden="true">*</span></label>
            <input asp-for="Name" class="input-app" required aria-required="true" />
            <span asp-validation-for="Name" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="ContactPerson">Contact Person</label>
            <input asp-for="ContactPerson" class="input-app" />
        </div>
        <div class="field">
            <label asp-for="WeChat">WeChat</label>
            <input asp-for="WeChat" class="input-app" />
        </div>
        <div class="field">
            <label asp-for="Phone">Phone</label>
            <input asp-for="Phone" class="input-app" />
        </div>
        <div class="field">
            <label asp-for="City">City</label>
            <input asp-for="City" class="input-app" />
        </div>
        <div class="field">
            <label asp-for="Country">Country</label>
            <input asp-for="Country" class="input-app" />
        </div>
        <div class="field form-grid--full">
            <label asp-for="Address">Address</label>
            <textarea asp-for="Address" class="textarea-app"></textarea>
        </div>
        <div class="field form-grid--full">
            <label asp-for="Notes">Notes</label>
            <textarea asp-for="Notes" class="textarea-app"></textarea>
        </div>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn-app btn-app--primary">Save Supplier</button>
        <a class="btn-app btn-app--outline" asp-action="Index">Cancel</a>
    </div>
</form>
