@model PagedResult<Supplier>
@{
    var pager = PagerViewModel.From(Model, "Index", new { search = Model.Search, sortBy = Model.SortBy, sortDesc = Model.SortDesc });
}

@section PageActions {
    @if (User.IsInRole(AppRoles.Owner))
    {
        <a class="btn-app btn-app--outline" asp-controller="Archive" asp-action="Index" asp-route-tab="suppliers"><svg class="ico" aria-hidden="true"><use href="#i-ban"></use></svg> Inactive</a>
    }
    <a class="btn-app btn-app--primary" asp-action="Create"><svg class="ico" aria-hidden="true"><use href="#i-plus"></use></svg> Add supplier</a>
}

<div class="card-panel">
    <form method="get" class="table-toolbar">
        <input class="input-app" type="search" name="search" value="@Model.Search" placeholder="Search code, name, WeChat, phone..." />
        <select class="select-app" name="sortBy">
            <option value="name" selected="@(Model.SortBy == "name" || string.IsNullOrEmpty(Model.SortBy))">Name</option>
            <option value="code" selected="@(Model.SortBy == "code")">Code</option>
            <option value="balance" selected="@(Model.SortBy == "balance")">Balance</option>
        </select>
        <button type="submit" class="btn-app btn-app--outline"><svg class="ico" aria-hidden="true"><use href="#i-filter"></use></svg> Filter</button>
    </form>

    <div class="table-wrap">
        <table class="table-app">
            <thead>
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Contact</th>
                <th>WeChat / Phone</th>
                <th>Purchases (RMB)</th>
                <th>Balance (PKR)</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="7"><div class="empty-state">No suppliers yet.</div></td></tr>
            }
            else
            {
                foreach (var s in Model.Items)
                {
                    <tr>
                        <td>@s.SupplierCode</td>
                        <td>@s.Name</td>
                        <td>@(s.ContactPerson ?? "—")</td>
                        <td>@(s.WeChat ?? "—") / @(s.Phone ?? "—")</td>
                        <td>¥ @s.TotalPurchasesRmb.ToString("N2")</td>
                        <td>Rs. @s.OutstandingBalancePkr.ToString("N2")</td>
                        <td class="actions">
                            <a class="btn-app btn-app--primary btn-app--icon" asp-action="Details" asp-route-id="@s.Id" title="View" aria-label="View"><svg class="ico" aria-hidden="true"><use href="#i-eye"></use></svg></a>
                            <a class="btn-app btn-app--success btn-app--icon" asp-action="Edit" asp-route-id="@s.Id" title="Edit" aria-label="Edit"><svg class="ico" aria-hidden="true"><use href="#i-pencil"></use></svg></a>
                            <form asp-action="Delete" method="post" class="row-action">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@s.Id" />
                                <button type="submit" class="btn-app btn-app--danger btn-app--icon" title="Deactivate" aria-label="Deactivate" data-confirm="Deactivate this supplier?"><svg class="ico" aria-hidden="true"><use href="#i-ban"></use></svg></button>
                            </form>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="pager" />
</div>
