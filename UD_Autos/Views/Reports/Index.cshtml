@model ReportsIndexViewModel

@{
    string Link(string family, string report) => Url.Action("Index", new { family, report, from = Model.From.ToString("yyyy-MM-dd"), to = Model.To.ToString("yyyy-MM-dd"), search = Model.Search })!;
}

@section PageActions {
    <a class="btn-app btn-app--outline" asp-action="Export" asp-route-family="@Model.Family" asp-route-report="@Model.Report" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" asp-route-search="@Model.Search" asp-route-format="csv">Export CSV</a>
    <a class="btn-app btn-app--primary" asp-action="Export" asp-route-family="@Model.Family" asp-route-report="@Model.Report" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" asp-route-search="@Model.Search" asp-route-format="xlsx">Export Excel</a>
}

<div class="card-panel">
    <div class="report-nav">
        <div class="report-nav__group">
            <span class="report-nav__label">Sales</span>
            <a class="btn-app btn-app--sm @(Model.Family=="sales"&&Model.Report=="daily"?"btn-app--primary":"btn-app--outline")" href="@Link("sales","daily")">Daily</a>
            <a class="btn-app btn-app--sm @(Model.Report=="monthly"&&Model.Family=="sales"?"btn-app--primary":"btn-app--outline")" href="@Link("sales","monthly")">Monthly</a>
            <a class="btn-app btn-app--sm @(Model.Report=="product"&&Model.Family=="sales"?"btn-app--primary":"btn-app--outline")" href="@Link("sales","product")">Product</a>
            <a class="btn-app btn-app--sm @(Model.Report=="customer"&&Model.Family=="sales"?"btn-app--primary":"btn-app--outline")" href="@Link("sales","customer")">Customer</a>
            <a class="btn-app btn-app--sm @(Model.Report=="channel"&&Model.Family=="sales"?"btn-app--primary":"btn-app--outline")" href="@Link("sales","channel")">Wholesale/Retail</a>
        </div>
        @if (Model.CanViewProfit)
        {
            <div class="report-nav__group">
                <span class="report-nav__label">Profit</span>
                <a class="btn-app btn-app--sm @(Model.Family=="profit"&&Model.Report=="monthly"?"btn-app--primary":"btn-app--outline")" href="@Link("profit","monthly")">P&amp;L</a>
                <a class="btn-app btn-app--sm @(Model.Family=="profit"&&Model.Report=="product"?"btn-app--primary":"btn-app--outline")" href="@Link("profit","product")">Product</a>
                <a class="btn-app btn-app--sm @(Model.Family=="profit"&&Model.Report=="invoice"?"btn-app--primary":"btn-app--outline")" href="@Link("profit","invoice")">Invoice</a>
                <a class="btn-app btn-app--sm @(Model.Family=="profit"&&Model.Report=="customer"?"btn-app--primary":"btn-app--outline")" href="@Link("profit","customer")">Customer</a>
                <a class="btn-app btn-app--sm @(Model.Family=="profit"&&Model.Report=="shipment"?"btn-app--primary":"btn-app--outline")" href="@Link("profit","shipment")">Shipment</a>
            </div>
        }
        <div class="report-nav__group">
            <span class="report-nav__label">Inventory</span>
            <a class="btn-app btn-app--sm @(Model.Family=="inventory"&&Model.Report=="stock"?"btn-app--primary":"btn-app--outline")" href="@Link("inventory","stock")">Stock</a>
            <a class="btn-app btn-app--sm @(Model.Family=="inventory"&&Model.Report=="value"?"btn-app--primary":"btn-app--outline")" href="@Link("inventory","value")">Value</a>
            <a class="btn-app btn-app--sm @(Model.Family=="inventory"&&Model.Report=="low"?"btn-app--primary":"btn-app--outline")" href="@Link("inventory","low")">Low</a>
            <a class="btn-app btn-app--sm @(Model.Family=="inventory"&&Model.Report=="batches"?"btn-app--primary":"btn-app--outline")" href="@Link("inventory","batches")">Batches</a>
            <a class="btn-app btn-app--sm @(Model.Family=="inventory"&&Model.Report=="aging"?"btn-app--primary":"btn-app--outline")" href="@Link("inventory","aging")">Aging</a>
        </div>
        <div class="report-nav__group">
            <span class="report-nav__label">Import</span>
            <a class="btn-app btn-app--sm @(Model.Family=="import"&&Model.Report=="supplier"?"btn-app--primary":"btn-app--outline")" href="@Link("import","supplier")">Purchases</a>
            <a class="btn-app btn-app--sm @(Model.Family=="import"&&Model.Report=="rmb"?"btn-app--primary":"btn-app--outline")" href="@Link("import","rmb")">RMB History</a>
            <a class="btn-app btn-app--sm @(Model.Family=="import"&&Model.Report=="rate"?"btn-app--primary":"btn-app--outline")" href="@Link("import","rate")">FX Rate</a>
            <a class="btn-app btn-app--sm @(Model.Family=="import"&&Model.Report=="landed"?"btn-app--primary":"btn-app--outline")" href="@Link("import","landed")">Landed</a>
        </div>
        <div class="report-nav__group">
            <span class="report-nav__label">Receivables</span>
            <a class="btn-app btn-app--sm @(Model.Family=="receivables"&&Model.Report=="balances"?"btn-app--primary":"btn-app--outline")" href="@Link("receivables","balances")">Balances</a>
            <a class="btn-app btn-app--sm @(Model.Family=="receivables"&&Model.Report=="aging"?"btn-app--primary":"btn-app--outline")" href="@Link("receivables","aging")">Aging</a>
            <a class="btn-app btn-app--sm @(Model.Family=="receivables"&&Model.Report=="overdue"?"btn-app--primary":"btn-app--outline")" href="@Link("receivables","overdue")">Overdue</a>
            <a class="btn-app btn-app--sm @(Model.Family=="receivables"&&Model.Report=="payments"?"btn-app--primary":"btn-app--outline")" href="@Link("receivables","payments")">Payments</a>
            <a class="btn-app btn-app--sm @(Model.Family=="receivables"&&Model.Report=="oldkhata"?"btn-app--primary":"btn-app--outline")" href="@Link("receivables","oldkhata")">Old Khata</a>
        </div>
    </div>

    <form method="get" class="table-toolbar">
        <input type="hidden" name="family" value="@Model.Family" />
        <input type="hidden" name="report" value="@Model.Report" />
        <input class="input-app" type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" />
        <input class="input-app" type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" />
        <input class="input-app" name="search" value="@Model.Search" placeholder="Search..." />
        <button type="submit" class="btn-app btn-app--outline">Run</button>
    </form>

    <h2 class="card-panel__title">@Model.Result.Title</h2>
    <p class="dashboard-note">@Model.Result.FormulaNote</p>

    <div class="table-wrap">
        <table class="table-app">
            <thead>
            <tr>
                @foreach (var h in Model.Result.Headers)
                {
                    <th>@h</th>
                }
            </tr>
            </thead>
            <tbody>
            @if (Model.Result.Rows.Count == 0)
            {
                <tr><td colspan="@Model.Result.Headers.Count"><div class="empty-state">No rows for this filter.</div></td></tr>
            }
            else
            {
                foreach (var r in Model.Result.Rows)
                {
                    var cells = new List<string?>();
                    var texts = new[] { r.Col1, r.Col2, r.Col3, r.Col4, r.Col5, r.Col6 }.Where(s => !string.IsNullOrEmpty(s)).ToList();
                    var amts = new[] { r.Amount1, r.Amount2, r.Amount3 }.Where(a => a.HasValue).Select(a => "Rs. " + a!.Value.ToString("N2")).ToList();
                    cells.AddRange(texts);
                    cells.AddRange(amts);
                    while (cells.Count < Model.Result.Headers.Count) cells.Add("");
                    <tr>
                        @for (var i = 0; i < Model.Result.Headers.Count; i++)
                        {
                            <td>@cells[i]</td>
                        }
                    </tr>
                }
            }
            </tbody>
            @if (Model.Result.Rows.Count > 0)
            {
                <tfoot>
                <tr>
                    <td colspan="@Math.Max(1, Model.Result.Headers.Count - 3)"><strong>Totals</strong></td>
                    @if (Model.Result.Total1 != 0 || Model.Result.Headers.Count >= 2)
                    {
                        <td><strong>@(Model.Result.Total1 != 0 ? Model.Result.Total1.ToString("N2") : "")</strong></td>
                    }
                    @if (Model.Result.Total2 != 0)
                    {
                        <td><strong>@Model.Result.Total2.ToString("N2")</strong></td>
                    }
                    @if (Model.Result.Total3 != 0)
                    {
                        <td><strong>@Model.Result.Total3.ToString("N2")</strong></td>
                    }
                </tr>
                </tfoot>
            }
        </table>
    </div>
</div>
