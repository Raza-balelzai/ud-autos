@model IReadOnlyList<UD_Autos.Models.Audit.AuditLog>

<div class="card-panel">
    <form method="get" class="table-toolbar">
        <input class="input-app" name="search" value="@ViewBag.Search" placeholder="Search action / user / reference..." />
        <input class="input-app" name="entityType" value="@ViewBag.EntityType" placeholder="Entity type e.g. Invoice" />
        <button type="submit" class="btn-app btn-app--outline"><svg class="ico" aria-hidden="true"><use href="#i-filter"></use></svg> Filter</button>
    </form>
    <div class="table-wrap">
        <table class="table-app">
            <thead>
            <tr><th>When (UTC)</th><th>Action</th><th>Entity</th><th>Reference</th><th>User</th><th>Reason</th></tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="6"><div class="empty-state">No audit entries.</div></td></tr>
            }
            else
            {
                foreach (var a in Model)
                {
                    <tr>
                        <td>@a.TimestampUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@a.Action</td>
                        <td>@a.EntityType #@a.EntityId</td>
                        <td>@a.ReferenceNumber</td>
                        <td>@a.UserName</td>
                        <td>@a.Reason</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
