@model ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot password";
}
<h1>Forgot password</h1>
<p class="lead">Enter the email on your account. If it exists, we will send a reset link.</p>

<form asp-action="ForgotPassword" method="post">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <div class="field">
        <label asp-for="Email" class="is-required">Email Address <span class="req" aria-hidden="true">*</span></label>
        <div class="login-input">
            <svg class="login-input__icon" aria-hidden="true"><use href="#i-mail"></use></svg>
            <input asp-for="Email" class="input-app" autocomplete="username" placeholder="name@company.com" required />
        </div>
        <span asp-validation-for="Email" class="field-error"></span>
    </div>
    <button type="submit" class="btn-app btn-app--primary login-submit">
        <svg class="ico" aria-hidden="true"><use href="#i-mail"></use></svg> Send reset link
    </button>
</form>

<p class="login-back"><a asp-action="Login">Back to sign in</a></p>
