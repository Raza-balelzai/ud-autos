@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign in";
}
<h1>Welcome Back</h1>
<p class="lead">Sign in to your account to continue</p>

@if (TempData["Success"] is string saved)
{
    <div class="alert-app alert-app--success">@saved</div>
}

<form asp-action="Login" method="post">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <input type="hidden" asp-for="ReturnUrl" />
    <div class="field">
        <label asp-for="Email" class="is-required">Email Address <span class="req" aria-hidden="true">*</span></label>
        <div class="login-input">
            <svg class="login-input__icon" aria-hidden="true"><use href="#i-mail"></use></svg>
            <input asp-for="Email" class="input-app" autocomplete="username" placeholder="name@company.com" required />
        </div>
        <span asp-validation-for="Email" class="field-error"></span>
    </div>
    <div class="field">
        <label asp-for="Password" class="is-required">Password <span class="req" aria-hidden="true">*</span></label>
        <div class="login-input login-input--secret">
            <svg class="login-input__icon" aria-hidden="true"><use href="#i-lock"></use></svg>
            <input asp-for="Password" id="login-password" class="input-app" autocomplete="current-password" placeholder="Enter your password" required />
            <button type="button" class="login-input__toggle" data-toggle-password="login-password" aria-label="Show password" aria-pressed="false">
                <svg class="ico" aria-hidden="true"><use href="#i-eye"></use></svg>
            </button>
        </div>
        <span asp-validation-for="Password" class="field-error"></span>
    </div>
    <div class="login-extras">
        <label class="checkbox-row login-remember">
            <input asp-for="RememberMe" />
            Remember me
        </label>
        <a asp-action="ForgotPassword">Forgot password?</a>
    </div>
    <button type="submit" class="btn-app btn-app--primary login-submit">
        <svg class="ico" aria-hidden="true"><use href="#i-login"></use></svg> Sign in
    </button>
</form>

<div class="login-or" aria-hidden="true"><span>OR</span></div>
<div class="login-note">
    <span class="login-note__icon" aria-hidden="true"><svg class="ico"><use href="#i-shield"></use></svg></span>
    <span><strong>Authorized Users Only</strong><small>This system is restricted to authorized personnel.</small></span>
</div>
