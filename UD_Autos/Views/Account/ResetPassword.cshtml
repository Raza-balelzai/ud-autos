@model ResetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Choose a new password";
}
<h1>Choose a new password</h1>
<p class="lead">Use at least 8 characters, with an uppercase letter, a lowercase letter, a number, and a symbol.</p>

<form asp-action="ResetPassword" method="post">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="Token" />
    <div class="field">
        <label asp-for="Password" class="is-required">New password <span class="req" aria-hidden="true">*</span></label>
        <div class="login-input login-input--secret">
            <svg class="login-input__icon" aria-hidden="true"><use href="#i-lock"></use></svg>
            <input asp-for="Password" id="reset-password" class="input-app" autocomplete="new-password" placeholder="New password" required />
            <button type="button" class="login-input__toggle" data-toggle-password="reset-password" aria-label="Show password" aria-pressed="false">
                <svg class="ico" aria-hidden="true"><use href="#i-eye"></use></svg>
            </button>
        </div>
        <span asp-validation-for="Password" class="field-error"></span>
    </div>
    <div class="field">
        <label asp-for="ConfirmPassword" class="is-required">Confirm password <span class="req" aria-hidden="true">*</span></label>
        <div class="login-input login-input--secret">
            <svg class="login-input__icon" aria-hidden="true"><use href="#i-lock"></use></svg>
            <input asp-for="ConfirmPassword" id="reset-confirm" class="input-app" autocomplete="new-password" placeholder="Confirm password" required />
            <button type="button" class="login-input__toggle" data-toggle-password="reset-confirm" aria-label="Show password" aria-pressed="false">
                <svg class="ico" aria-hidden="true"><use href="#i-eye"></use></svg>
            </button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
    </div>
    <button type="submit" class="btn-app btn-app--primary login-submit">
        <svg class="ico" aria-hidden="true"><use href="#i-check"></use></svg> Save password
    </button>
</form>

<p class="login-back"><a asp-action="ForgotPassword">Request a new link</a></p>
