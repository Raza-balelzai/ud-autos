@model IReadOnlyList<ArchiveRow>
@{
    var tab = (string?)ViewBag.Tab ?? "products";
    string TabClass(string name) => tab == name ? "is-active" : "";
    var deleteConfirm = tab switch
    {
        "customers" => "Permanently delete this customer? This cannot be undone.",
        "suppliers" => "Permanently delete this supplier? This cannot be undone. Products that only listed this supplier will keep working.",
        "categories" => "Permanently delete this category? Products that used it will keep working with the category cleared.",
        "units" => "Permanently delete this unit? Products that used it will keep working with the unit cleared.",
        "expenses" => "Permanently delete this expense category? This cannot be undone.",
        _ => "Permanently delete this product? This cannot be undone."
    };
    var codeLabel = tab is "units" ? "Abbreviation" : "Code";
}

<div class="card-panel">
    <div class="tabs-app">
        <a class="@TabClass("products")" asp-action="Index" asp-route-tab="products">Products</a>
        <a class="@TabClass("customers")" asp-action="Index" asp-route-tab="customers">Customers</a>
        <a class="@TabClass("suppliers")" asp-action="Index" asp-route-tab="suppliers">Suppliers</a>
        <a class="@TabClass("categories")" asp-action="Index" asp-route-tab="categories">Categories</a>
        <a class="@TabClass("units")" asp-action="Index" asp-route-tab="units">Units</a>
        <a class="@TabClass("expenses")" asp-action="Index" asp-route-tab="expenses">Expense categories</a>
    </div>
    <p class="hint">Reactivate puts a record back on its list. Permanent delete is available only when nothing in the shop still uses it.</p>

    <div class="table-wrap">
        <table class="table-app">
            <thead>
            <tr><th>@codeLabel</th><th>Name</th><th>Note</th><th>Actions</th></tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="4"><div class="empty-state">No inactive records on this tab.</div></td></tr>
            }
            else
            {
                foreach (var row in Model)
                {
                    <tr>
                        <td>@(string.IsNullOrWhiteSpace(row.Code) ? "—" : row.Code)</td>
                        <td>@row.Name</td>
                        <td>@(string.IsNullOrWhiteSpace(row.Note) ? "—" : row.Note)</td>
                        <td>
                            <div class="user-actions">
                                <form asp-action="Reactivate" method="post" class="user-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="tab" value="@tab" />
                                    <input type="hidden" name="id" value="@row.Id" />
                                    <button type="submit" class="btn-app btn-app--success btn-app--sm"><svg class="ico" aria-hidden="true"><use href="#i-check"></use></svg> Reactivate</button>
                                </form>
                                @if (row.CanHardDelete)
                                {
                                    <form asp-action="HardDelete" method="post" class="user-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="tab" value="@tab" />
                                        <input type="hidden" name="id" value="@row.Id" />
                                        <button type="submit" class="btn-app btn-app--danger btn-app--sm" onclick="return confirm('@deleteConfirm');"><svg class="ico" aria-hidden="true"><use href="#i-trash"></use></svg> Delete permanently</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="hint">@row.BlockReason</span>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
