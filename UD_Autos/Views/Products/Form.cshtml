@model ProductFormViewModel
@{
    var isEdit = Model.Product.Id > 0;
}

<form asp-action="@(isEdit ? "Edit" : "Create")" method="post" enctype="multipart/form-data" class="card-panel">
    @if (isEdit)
    {
        <input type="hidden" asp-for="Product.Id" />
    }
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

    <div class="form-grid form-grid--3">
        <div class="field">
            <label asp-for="Product.Sku">SKU / Item Code</label>
            <input asp-for="Product.Sku" class="input-app" placeholder="Leave blank to auto-generate" />
            <span asp-validation-for="Product.Sku" class="field-error"></span>
        </div>
        <div class="field form-grid--full">
            <label asp-for="Product.Name">Product Name</label>
            <input asp-for="Product.Name" class="input-app" />
            <span asp-validation-for="Product.Name" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Product.CategoryId">Category</label>
            <select asp-for="Product.CategoryId" class="select-app" asp-items="@(new SelectList(Model.Categories, "Id", "Name"))">
                <option value="">— Select —</option>
            </select>
        </div>
        <div class="field">
            <label asp-for="Product.UnitId">Unit</label>
            <select asp-for="Product.UnitId" class="select-app" asp-items="@(new SelectList(Model.Units, "Id", "Name"))">
                <option value="">— Select —</option>
            </select>
        </div>
        <div class="field">
            <label asp-for="Product.DefaultSupplierId">Default Supplier / Factory</label>
            <select asp-for="Product.DefaultSupplierId" class="select-app" asp-items="@(new SelectList(Model.Suppliers, "Id", "Name"))">
                <option value="">— Select —</option>
            </select>
        </div>
        <div class="field">
            <label asp-for="Product.Brand">Brand</label>
            <input asp-for="Product.Brand" class="input-app" />
        </div>
        <div class="field">
            <label asp-for="Product.VehicleBrand">Vehicle Brand</label>
            <input asp-for="Product.VehicleBrand" class="input-app" />
        </div>
        <div class="field">
            <label asp-for="Product.VehicleModel">Vehicle Model</label>
            <input asp-for="Product.VehicleModel" class="input-app" />
        </div>
        <div class="field">
            <label asp-for="Product.VariantYear">Variant / Year</label>
            <input asp-for="Product.VariantYear" class="input-app" />
        </div>
        <div class="field">
            <label asp-for="ImageFile">Product Image</label>
            <input asp-for="ImageFile" type="file" class="input-app" accept=".jpg,.jpeg,.png,.webp,.gif" />
            @if (!string.IsNullOrEmpty(Model.Product.ImagePath))
            {
                <span class="hint">Current: @Model.Product.ImagePath</span>
                <input type="hidden" asp-for="Product.ImagePath" />
            }
        </div>
    </div>

    <h3 class="card-panel__title">Physical</h3>
    <div class="form-grid form-grid--3">
        <div class="field"><label asp-for="Product.UnitWeightKg">Unit Weight (Kg)</label><input asp-for="Product.UnitWeightKg" class="input-app" /></div>
        <div class="field"><label asp-for="Product.CartonWeightKg">Carton Weight (Kg)</label><input asp-for="Product.CartonWeightKg" class="input-app" /></div>
        <div class="field"><label asp-for="Product.PiecesPerCarton">Pieces / Carton</label><input asp-for="Product.PiecesPerCarton" class="input-app" /></div>
        <div class="field"><label asp-for="Product.LengthCm">Length (cm)</label><input asp-for="Product.LengthCm" class="input-app" /></div>
        <div class="field"><label asp-for="Product.WidthCm">Width (cm)</label><input asp-for="Product.WidthCm" class="input-app" /></div>
        <div class="field"><label asp-for="Product.HeightCm">Height (cm)</label><input asp-for="Product.HeightCm" class="input-app" /></div>
    </div>

    <h3 class="card-panel__title">Pricing</h3>
    <div class="form-grid form-grid--3">
        @if (User.IsInRole(AppRoles.Owner) || User.IsInRole(AppRoles.Manager) || User.IsInRole(AppRoles.Accountant))
        {
            <div class="field"><label asp-for="Product.LatestRmbPrice">Latest RMB Price</label><input asp-for="Product.LatestRmbPrice" class="input-app" /><span class="hint">History preserved on change</span></div>
            <div class="field"><label asp-for="Product.LatestLandedCost">Latest Landed Cost (PKR)</label><input asp-for="Product.LatestLandedCost" class="input-app" /><span class="hint">History preserved on change</span></div>
            <div class="field"><label asp-for="PriceChangeReason">Price change reason</label><input asp-for="PriceChangeReason" class="input-app" /></div>
        }
        <div class="field"><label asp-for="Product.WholesalePrice">Wholesale Price</label><input asp-for="Product.WholesalePrice" class="input-app" /></div>
        <div class="field"><label asp-for="Product.RetailPrice">Retail Price</label><input asp-for="Product.RetailPrice" class="input-app" /></div>
        <div class="field"><label asp-for="Product.MinimumSalePrice">Minimum Sale Price</label><input asp-for="Product.MinimumSalePrice" class="input-app" /></div>
        <div class="field"><label asp-for="Product.ReorderLevel">Reorder Level</label><input asp-for="Product.ReorderLevel" class="input-app" /></div>
        <div class="field form-grid--full"><label asp-for="Product.Description">Details</label><textarea asp-for="Product.Description" class="textarea-app"></textarea></div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn-app btn-app--primary">@(isEdit ? "Save Changes" : "Create Product")</button>
        <a class="btn-app btn-app--outline" asp-action="Index">Cancel</a>
    </div>
</form>
