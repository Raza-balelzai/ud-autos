@model ProductFormViewModel
@{
    var isEdit = Model.Product.Id > 0;
    var isSet = Model.Product.ProductKind == ProductKind.CompleteSet;
    var canViewCosts = User.IsInRole(AppRoles.Owner) || User.IsInRole(AppRoles.Manager) || User.IsInRole(AppRoles.Accountant);
    var unitKey = (Model.Units.FirstOrDefault(u => u.Id == Model.Product.UnitId)?.Name ?? "").Trim().ToLowerInvariant();
    var showQuantity = !isEdit && !isSet && unitKey is "piece" or "set" or "pair" or "kilogram" or "carton";
    var showSize = unitKey == "carton";
    var showUnitHint = !isSet && unitKey.Length == 0;
    var showMeasure = !isSet && (showQuantity || showSize || showUnitHint);
    var quantityNoun = unitKey switch
    {
        "kilogram" => "kg",
        "carton" => "cartons",
        "pair" => "pairs",
        "set" => "sets",
        _ => "pieces"
    };
    string Num(decimal? value) => value is null or 0m
        ? ""
        : value.Value.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);
    string Invalid(string key) => ViewData.ModelState.TryGetValue(key, out var entry) && entry.Errors.Count > 0
        ? "input-validation-error"
        : "";
}

<form asp-action="@(isEdit ? "Edit" : "Create")" method="post" enctype="multipart/form-data" class="card-panel">
    @if (isEdit)
    {
        <input type="hidden" asp-for="Product.Id" />
        <input type="hidden" asp-for="Product.IsActive" />
    }
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <p class="form-legend"><span class="req" aria-hidden="true">*</span> Required field</p>

    <section class="form-section form-section--first">
        <div class="form-section__head">
            <h3 class="form-section__title">Product</h3>
        </div>
        <div class="form-grid form-grid--3">
            <div class="field form-grid--full">
                <div class="label-row">
                    <label asp-for="Product.Name" class="is-required">Product name <span class="req" aria-hidden="true">*</span></label>
                    <partial name="_FieldTip" model='@("Name shown on invoices and stock lists.")' />
                </div>
                <input asp-for="Product.Name" class="input-app" required aria-required="true" placeholder="e.g. Complete truck bumper set" />
                <span asp-validation-for="Product.Name" class="field-error"></span>
            </div>
            <div class="field">
                <div class="label-row">
                    <label class="is-required" for="product-kind">Product type <span class="req" aria-hidden="true">*</span></label>
                    <partial name="_FieldTip" model='@("Single item is one part. Complete set is sold as one price but stock comes from its items.")' />
                </div>
                <select asp-for="Product.ProductKind" class="select-app" id="product-kind">
                    <option value="@((int)ProductKind.SingleItem)">Single item</option>
                    <option value="@((int)ProductKind.CompleteSet)">Complete set</option>
                </select>
                <span asp-validation-for="Product.ProductKind" class="field-error"></span>
            </div>
            <div class="field">
                <div class="label-row">
                    <label asp-for="Product.Sku">SKU @(isEdit ? Html.Raw("<span class=\"req\" aria-hidden=\"true\">*</span>") : null)</label>
                    <partial name="_FieldTip" model='@("Your product code. Leave blank and one is created on save.")' />
                </div>
                <input asp-for="Product.Sku" class="input-app" placeholder="@(isEdit ? "" : "Leave blank to auto-generate")" aria-required="@(isEdit ? "true" : "false")" />
                @if (!isEdit)
                {
                    <span class="hint">Optional. A blank SKU is generated on save.</span>
                }
                <span asp-validation-for="Product.Sku" class="field-error"></span>
            </div>
            <div class="field">
                <div class="label-row">
                    <label asp-for="Product.Barcode">Barcode</label>
                    <partial name="_FieldTip" model='@("Scan code if you use a scanner. Optional.")' />
                </div>
                <input asp-for="Product.Barcode" class="input-app" placeholder="Scan code, if you use one" />
                <span class="hint">Optional</span>
                <span asp-validation-for="Product.Barcode" class="field-error"></span>
            </div>
        </div>
    </section>

    <section id="set-editor" class="form-section" @(isSet ? null : "hidden")>
        <div class="form-section__head">
            <h3 class="form-section__title">Set items</h3>
        </div>
        <div class="table-toolbar">
            <input class="input-app" id="component-search" placeholder="Search by SKU or name" autocomplete="off" />
            <button type="button" class="btn-app btn-app--outline btn-app--sm" id="component-add"><svg class="ico" aria-hidden="true"><use href="#i-plus"></use></svg> Add selected item</button>
        </div>
        <div id="component-results"></div>
        <div class="table-wrap">
            <table class="table-app" id="component-table">
                <thead>
                <tr><th>Item</th><th>Required quantity</th><th>Available stock</th><th></th></tr>
                </thead>
                <tbody>
                @for (var i = 0; i < Model.Components.Count; i++)
                {
                    <tr data-component-row data-id="@Model.Components[i].ComponentProductId">
                        <td>
                            @Model.Components[i].Sku — @Model.Components[i].Name
                            <input type="hidden" name="Components[@i].ComponentProductId" value="@Model.Components[i].ComponentProductId" />
                            <input type="hidden" name="Components[@i].Sku" value="@Model.Components[i].Sku" />
                            <input type="hidden" name="Components[@i].Name" value="@Model.Components[i].Name" />
                            <input type="hidden" name="Components[@i].AvailableStock" value="@Model.Components[i].AvailableStock" />
                        </td>
                        <td><input class="input-app qty-input" name="Components[@i].RequiredQuantity" value="@Model.Components[i].RequiredQuantity" /></td>
                        <td>@Model.Components[i].AvailableStock.ToString("N2")</td>
                        <td><button type="button" class="btn-app btn-app--ghost btn-app--sm" data-remove-component><svg class="ico" aria-hidden="true"><use href="#i-trash"></use></svg> Remove</button></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <p class="hint" id="component-empty" @(Model.Components.Count > 0 ? "hidden" : null)>No items yet. Search above and add at least one.</p>
    </section>

    <section class="form-section">
        <div class="form-section__head">
            <h3 class="form-section__title">Classification</h3>
        </div>
        <div class="form-grid form-grid--3">
            <div class="field">
                <div class="label-row">
                    <label asp-for="Product.CategoryId">Category</label>
                    <partial name="_FieldTip" model='@("Group used for filters, such as bumper or light.")' />
                </div>
                <select asp-for="Product.CategoryId" class="select-app" asp-items="@(new SelectList(Model.Categories, "Id", "Name"))">
                    <option value="">Select category</option>
                </select>
                <span asp-validation-for="Product.CategoryId" class="field-error"></span>
            </div>
            <div class="field">
                <div class="label-row">
                    <label asp-for="Product.UnitId">Unit</label>
                    <partial name="_FieldTip" model='@("How you count this product. Piece shows a quantity. Carton shows carton size and weight.")' />
                </div>
                <select asp-for="Product.UnitId" class="select-app" asp-items="@(new SelectList(Model.Units, "Id", "Name"))">
                    <option value="">Select unit</option>
                </select>
                <span asp-validation-for="Product.UnitId" class="field-error"></span>
            </div>
            <div class="field">
                <div class="label-row">
                    <label asp-for="Product.DefaultSupplierId">Default supplier</label>
                    <partial name="_FieldTip" model='@("Who you usually buy this from. Optional.")' />
                </div>
                <select asp-for="Product.DefaultSupplierId" class="select-app" asp-items="@(new SelectList(Model.Suppliers, "Id", "Name"))">
                    <option value="">Select supplier</option>
                </select>
                <span asp-validation-for="Product.DefaultSupplierId" class="field-error"></span>
            </div>
            <div class="field">
                <div class="label-row">
                    <label asp-for="Product.Brand">Brand</label>
                    <partial name="_FieldTip" model='@("Maker of the part. Optional.")' />
                </div>
                <input asp-for="Product.Brand" class="input-app" />
                <span asp-validation-for="Product.Brand" class="field-error"></span>
            </div>
            <div class="field">
                <div class="label-row">
                    <label asp-for="Product.VehicleBrand">Vehicle brand</label>
                    <partial name="_FieldTip" model='@("Vehicle make this part fits. Optional.")' />
                </div>
                <input asp-for="Product.VehicleBrand" class="input-app" />
                <span asp-validation-for="Product.VehicleBrand" class="field-error"></span>
            </div>
            <div class="field">
                <div class="label-row">
                    <label asp-for="Product.VehicleModel">Vehicle model</label>
                    <partial name="_FieldTip" model='@("Vehicle model this part fits. Optional.")' />
                </div>
                <input asp-for="Product.VehicleModel" class="input-app" />
                <span asp-validation-for="Product.VehicleModel" class="field-error"></span>
            </div>
            <div class="field">
                <div class="label-row">
                    <label asp-for="Product.VariantYear">Variant or year</label>
                    <partial name="_FieldTip" model='@("Year or variant this part fits. Optional.")' />
                </div>
                <input asp-for="Product.VariantYear" class="input-app" />
                <span asp-validation-for="Product.VariantYear" class="field-error"></span>
            </div>
            <div class="field">
                <div class="label-row">
                    <label asp-for="ImageFile">Product image</label>
                    <partial name="_FieldTip" model='@("Optional photo. JPG, PNG, WEBP, or GIF under 2 MB.")' />
                </div>
                <input asp-for="ImageFile" type="file" class="input-app" accept=".jpg,.jpeg,.png,.webp,.gif" />
                @if (!string.IsNullOrEmpty(Model.Product.ImagePath))
                {
                    <span class="hint">Current image: @Model.Product.ImagePath</span>
                    <input type="hidden" asp-for="Product.ImagePath" />
                }
                else
                {
                    <span class="hint">Optional. JPG, PNG, WEBP, or GIF under 2 MB.</span>
                }
                <span asp-validation-for="ImageFile" class="field-error"></span>
            </div>
        </div>
    </section>

    <section class="form-section">
        <div class="form-section__head">
            <h3 class="form-section__title">Prices</h3>
        </div>
        <div class="form-grid form-grid--3">
            <div class="field">
                <div class="label-row">
                    <label for="Product_WholesalePrice" id="selling-price-label">@(isSet ? "Set price" : "Wholesale price")</label>
                    <partial name="_FieldTip" model='@("Default price charged on a sale. Not your cost.")' />
                </div>
                <input id="Product_WholesalePrice" name="Product.WholesalePrice" class="input-app @Invalid("Product.WholesalePrice")" data-val="false" inputmode="decimal" value="@Num(Model.Product.WholesalePrice)" />
                <span class="hint" id="selling-price-hint">@(isSet ? "Price charged for one complete set. You can still change it on the sale." : "Default price on a sale.")</span>
                <span asp-validation-for="Product.WholesalePrice" class="field-error"></span>
            </div>
            <div class="field">
                <div class="label-row">
                    <label for="Product_RetailPrice">Retail price</label>
                    <partial name="_FieldTip" model='@("Walk-in or counter price. Optional.")' />
                </div>
                <input id="Product_RetailPrice" name="Product.RetailPrice" class="input-app @Invalid("Product.RetailPrice")" data-val="false" inputmode="decimal" value="@Num(Model.Product.RetailPrice)" />
                <span class="hint">Optional reference price.</span>
                <span asp-validation-for="Product.RetailPrice" class="field-error"></span>
            </div>
            <div class="field">
                <div class="label-row">
                    <label for="Product_MinimumSalePrice">Minimum sale price</label>
                    <partial name="_FieldTip" model='@("Lowest price allowed on a sale. Blank or 0 means no limit.")' />
                </div>
                <input id="Product_MinimumSalePrice" name="Product.MinimumSalePrice" class="input-app @Invalid("Product.MinimumSalePrice")" data-val="false" inputmode="decimal" value="@Num(Model.Product.MinimumSalePrice)" />
                <span class="hint">Leave blank if there is no minimum.</span>
                <span asp-validation-for="Product.MinimumSalePrice" class="field-error"></span>
            </div>
        </div>
        @if (canViewCosts)
        {
            <p class="hint">These are selling prices. The price you paid goes in Purchase price under Cost.</p>
        }
    </section>

    <section class="form-section" id="stock-section" @(isSet ? "hidden" : null)>
        <div class="form-section__head">
            <h3 class="form-section__title">Stock alert</h3>
        </div>
        <div class="form-grid form-grid--3">
            <div class="field">
                <div class="label-row">
                    <label for="Product_ReorderLevel">Reorder level</label>
                    <partial name="_FieldTip" model='@("Warn when stock falls to this number. Optional.")' />
                </div>
                <input id="Product_ReorderLevel" name="Product.ReorderLevel" class="input-app @Invalid("Product.ReorderLevel")" data-val="false" inputmode="decimal" value="@Num(Model.Product.ReorderLevel)" />
                <span asp-validation-for="Product.ReorderLevel" class="field-error"></span>
            </div>
        </div>
    </section>

    <section class="form-section" id="measure-section" @(showMeasure ? null : "hidden")>
        <div class="form-section__head">
            <h3 class="form-section__title">Quantity and size</h3>
        </div>
        <p class="hint" id="unit-hint" @(showUnitHint ? null : "hidden")>Select a unit first.</p>
        @if (!isEdit)
        {
            <div id="quantity-block" @(showQuantity ? null : "hidden")>
                <div class="form-grid form-grid--3">
                    <div class="field">
                        <div class="label-row">
                            <label for="Product_CurrentStock" id="quantity-label">Quantity (@quantityNoun)</label>
                            <partial name="_FieldTip" model='@("How many you already have. Leave blank if stock will come in later.")' />
                        </div>
                        <input id="Product_CurrentStock" name="Product.CurrentStock" class="input-app @Invalid("Product.CurrentStock")" data-val="false" inputmode="decimal" value="@Num(Model.Product.CurrentStock)" disabled="@(showQuantity ? null : "disabled")" />
                        <span asp-validation-for="Product.CurrentStock" class="field-error"></span>
                    </div>
                </div>
            </div>
        }
        <div id="size-block" @(showSize ? null : "hidden")>
            <div class="form-grid form-grid--3">
                <div class="field">
                    <div class="label-row">
                        <label asp-for="Product.UnitWeightKg">Unit weight (kg)</label>
                        <partial name="_FieldTip" model='@("Weight of one unit in kilograms. Optional.")' />
                    </div>
                    <input asp-for="Product.UnitWeightKg" class="input-app" data-val="false" disabled="@(showSize ? null : "disabled")" />
                    <span asp-validation-for="Product.UnitWeightKg" class="field-error"></span>
                </div>
                <div class="field">
                    <div class="label-row">
                        <label asp-for="Product.CartonWeightKg">Carton weight (kg)</label>
                        <partial name="_FieldTip" model='@("Weight of one full carton in kilograms.")' />
                    </div>
                    <input asp-for="Product.CartonWeightKg" class="input-app" data-val="false" disabled="@(showSize ? null : "disabled")" />
                    <span asp-validation-for="Product.CartonWeightKg" class="field-error"></span>
                </div>
                <div class="field">
                    <div class="label-row">
                        <label asp-for="Product.PiecesPerCarton">Pieces per carton</label>
                        <partial name="_FieldTip" model='@("How many pieces are packed in one carton.")' />
                    </div>
                    <input asp-for="Product.PiecesPerCarton" class="input-app" data-val="false" disabled="@(showSize ? null : "disabled")" />
                    <span asp-validation-for="Product.PiecesPerCarton" class="field-error"></span>
                </div>
                <div class="field">
                    <div class="label-row">
                        <label asp-for="Product.LengthCm">Length (cm)</label>
                        <partial name="_FieldTip" model='@("Carton length in centimetres. Used for shipping volume.")' />
                    </div>
                    <input asp-for="Product.LengthCm" class="input-app" data-val="false" disabled="@(showSize ? null : "disabled")" />
                    <span asp-validation-for="Product.LengthCm" class="field-error"></span>
                </div>
                <div class="field">
                    <div class="label-row">
                        <label asp-for="Product.WidthCm">Width (cm)</label>
                        <partial name="_FieldTip" model='@("Carton width in centimetres. Used for shipping volume.")' />
                    </div>
                    <input asp-for="Product.WidthCm" class="input-app" data-val="false" disabled="@(showSize ? null : "disabled")" />
                    <span asp-validation-for="Product.WidthCm" class="field-error"></span>
                </div>
                <div class="field">
                    <div class="label-row">
                        <label asp-for="Product.HeightCm">Height (cm)</label>
                        <partial name="_FieldTip" model='@("Carton height in centimetres. Used for shipping volume.")' />
                    </div>
                    <input asp-for="Product.HeightCm" class="input-app" data-val="false" disabled="@(showSize ? null : "disabled")" />
                    <span asp-validation-for="Product.HeightCm" class="field-error"></span>
                </div>
            </div>
        </div>
    </section>

    @if (canViewCosts)
    {
        <section class="form-section">
            <div class="form-section__head">
                <h3 class="form-section__title">Cost</h3>
            </div>
            <div class="form-grid form-grid--3">
                <div class="field">
                    <div class="label-row">
                        <label asp-for="Product.LatestRmbPrice">Latest RMB price</label>
                        <partial name="_FieldTip" model='@("China supplier price in yuan. Leave blank if you bought locally.")' />
                    </div>
                    <input asp-for="Product.LatestRmbPrice" class="input-app" data-val="false" />
                    <span class="hint">Only for a China purchase. History is kept when this changes.</span>
                    <span asp-validation-for="Product.LatestRmbPrice" class="field-error"></span>
                </div>
                <div class="field">
                    <div class="label-row">
                        <label asp-for="Product.LatestLandedCost">Purchase price (PKR)</label>
                        <partial name="_FieldTip" model='@("What you paid per unit in rupees. Use this for a local purchase. Leave RMB blank.")' />
                    </div>
                    <input asp-for="Product.LatestLandedCost" class="input-app" data-val="false" />
                    <span class="hint">Local purchase price, or the final rupee cost after shipping for a China import.</span>
                    <span asp-validation-for="Product.LatestLandedCost" class="field-error"></span>
                </div>
                <div class="field">
                    <div class="label-row">
                        <label asp-for="PriceChangeReason">Price change reason</label>
                        <partial name="_FieldTip" model='@("Only when you change wholesale, retail, or minimum price on an existing product.")' />
                    </div>
                    <input asp-for="PriceChangeReason" class="input-app" placeholder="Required only if a sale price changed" />
                    <span asp-validation-for="PriceChangeReason" class="field-error"></span>
                </div>
            </div>
        </section>
    }

    <section class="form-section">
        <div class="form-section__head">
            <h3 class="form-section__title">Notes</h3>
        </div>
        <div class="field">
            <div class="label-row">
                <label asp-for="Product.Description">Description</label>
                <partial name="_FieldTip" model='@("Optional notes for the shop.")' />
            </div>
            <textarea asp-for="Product.Description" class="textarea-app" placeholder="Optional notes for the shop"></textarea>
            <span asp-validation-for="Product.Description" class="field-error"></span>
        </div>
    </section>

    <div class="form-actions">
        <button type="submit" class="btn-app btn-app--primary" id="product-save"><svg class="ico" aria-hidden="true"><use href="@(isEdit ? "#i-check" : "#i-plus")"></use></svg> @(isEdit ? "Save changes" : "Create product")</button>
        <a class="btn-app btn-app--outline" asp-action="Index"><svg class="ico" aria-hidden="true"><use href="#i-x"></use></svg> Cancel</a>
    </div>
</form>

@section Scripts {
<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.js"></script>
<script>
(() => {
  const kind = document.getElementById('product-kind');
  const editor = document.getElementById('set-editor');
  const stock = document.getElementById('stock-section');
  const save = document.getElementById('product-save');
  const priceLabel = document.getElementById('selling-price-label');
  const priceHint = document.getElementById('selling-price-hint');
  const isEdit = @(isEdit ? "true" : "false");
  const unit = document.getElementById('Product_UnitId');
  const measure = document.getElementById('measure-section');
  const quantityBlock = document.getElementById('quantity-block');
  const sizeBlock = document.getElementById('size-block');
  const unitHint = document.getElementById('unit-hint');
  const qtyInput = document.getElementById('Product_CurrentStock');
  const qtyLabel = document.getElementById('quantity-label');
  const search = document.getElementById('component-search');
  const results = document.getElementById('component-results');
  const tableBody = document.querySelector('#component-table tbody');
  const emptyNote = document.getElementById('component-empty');

  function syncEmpty() {
    if (!emptyNote || !tableBody) return;
    emptyNote.hidden = tableBody.querySelectorAll('[data-component-row]').length > 0;
  }

  function selectedUnit() {
    const opt = unit && unit.selectedOptions ? unit.selectedOptions[0] : null;
    if (!opt || !opt.value) return '';
    return opt.text.trim().toLowerCase();
  }

  function syncMeasure() {
    const key = selectedUnit();
    const setSelected = kind && kind.value === '1';
    const isCarton = key === 'carton';
    const countable = key === 'piece' || key === 'set' || key === 'pair' || key === 'kilogram' || isCarton;
    const showQty = !isEdit && !setSelected && countable;
    const showSize = isCarton;
    const showHint = !setSelected && !key;
    if (quantityBlock) quantityBlock.hidden = !showQty;
    if (sizeBlock) sizeBlock.hidden = !showSize;
    if (unitHint) unitHint.hidden = !showHint;
    if (measure) measure.hidden = !!setSelected || (!showQty && !showSize && !showHint);
    if (qtyInput) qtyInput.disabled = !showQty;
    if (sizeBlock) {
      sizeBlock.querySelectorAll('input').forEach(input => { input.disabled = !showSize; });
    }
    if (qtyLabel) {
      const noun = key === 'kilogram' ? 'kg'
        : key === 'carton' ? 'cartons'
        : key === 'pair' ? 'pairs'
        : key === 'set' ? 'sets'
        : 'pieces';
      qtyLabel.textContent = 'Quantity (' + noun + ')';
    }
  }

  function syncKind() {
    const setSelected = kind && kind.value === '1';
    if (editor) editor.hidden = !setSelected;
    if (stock) stock.hidden = !!setSelected;
    if (priceLabel) priceLabel.textContent = setSelected ? 'Set price' : 'Wholesale price';
    if (priceHint) priceHint.textContent = setSelected
      ? 'Price charged for one complete set. You can still change it on the sale.'
      : 'Default price on a sale.';
    if (save) {
      const icon = save.querySelector('.ico');
      const label = isEdit ? 'Save changes' : (setSelected ? 'Create set' : 'Create product');
      save.textContent = '';
      if (icon) save.appendChild(icon);
      save.append(document.createTextNode(' ' + label));
    }
    syncMeasure();
  }

  function reindex() {
    tableBody.querySelectorAll('[data-component-row]').forEach((row, i) => {
      row.querySelectorAll('[name]').forEach(input => {
        input.name = input.name.replace(/Components\[\d+\]/, 'Components[' + i + ']');
      });
    });
    syncEmpty();
  }

  function hasId(id) {
    return !!tableBody.querySelector('[data-component-row][data-id="' + id + '"]');
  }

  function text(value) {
    return String(value ?? '').replace(/[&<>"']/g, ch => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[ch]));
  }

  function addRow(item) {
    if (hasId(item.id)) return;
    const i = tableBody.querySelectorAll('[data-component-row]').length;
    const tr = document.createElement('tr');
    tr.dataset.componentRow = '';
    tr.dataset.id = item.id;
    tr.innerHTML =
      '<td>' + text(item.sku) + ' — ' + text(item.name) +
      '<input type="hidden" name="Components[' + i + '].ComponentProductId" value="' + text(item.id) + '" />' +
      '<input type="hidden" name="Components[' + i + '].Sku" value="' + text(item.sku) + '" />' +
      '<input type="hidden" name="Components[' + i + '].Name" value="' + text(item.name) + '" />' +
      '<input type="hidden" name="Components[' + i + '].AvailableStock" value="' + text(item.available) + '" />' +
      '</td>' +
      '<td><input class="input-app qty-input" name="Components[' + i + '].RequiredQuantity" value="1" /></td>' +
      '<td>' + Number(item.available).toFixed(2) + '</td>' +
      '<td><button type="button" class="btn-app btn-app--ghost btn-app--sm" data-remove-component><svg class="ico" aria-hidden="true"><use href="#i-trash"></use></svg> Remove</button></td>';
    tableBody.appendChild(tr);
    syncEmpty();
  }

  let matches = [];
  async function runSearch() {
    const q = search.value.trim();
    if (q.length < 1) {
      matches = [];
      results.innerHTML = '';
      return;
    }
    const res = await fetch('/Products/SearchComponents?q=' + encodeURIComponent(q));
    if (!res.ok) return;
    matches = await res.json();
    results.innerHTML = matches.length === 0
      ? '<p class="hint">No matching single items.</p>'
      : '<div class="component-picks">' + matches.map((m, idx) =>
        '<button type="button" class="btn-app btn-app--outline btn-app--sm" data-pick="' + idx + '"><svg class="ico" aria-hidden="true"><use href="#i-plus"></use></svg> ' +
        text(m.sku) + ' — ' + text(m.name) + ' · ' + Number(m.available).toFixed(0) + ' in stock</button>').join('') + '</div>';
  }

  kind?.addEventListener('change', syncKind);
  unit?.addEventListener('change', syncMeasure);
  search?.addEventListener('input', () => { runSearch(); });
  search?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      if (matches[0]) addRow(matches[0]);
    }
  });
  document.getElementById('component-add')?.addEventListener('click', () => {
    if (matches[0]) addRow(matches[0]);
  });
  results?.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-pick]');
    if (!btn) return;
    const item = matches[Number(btn.dataset.pick)];
    if (item) addRow(item);
  });
  tableBody?.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-remove-component]');
    if (!btn) return;
    btn.closest('[data-component-row]')?.remove();
    reindex();
  });
  syncKind();
  syncEmpty();
})();
</script>
}
