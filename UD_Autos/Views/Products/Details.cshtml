@model Product
@{
    var canViewCosts = ViewBag.CanViewCosts as bool? ?? false;
}

@section PageActions {
    <a class="btn-app btn-app--outline" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        @Html.AntiForgeryToken()
        <button type="submit" class="btn-app btn-app--danger" onclick="return confirm('Deactivate this product?');">Deactivate</button>
    </form>
}

<div class="card-panel">
    <div class="tabs-app">
        <a class="is-active" href="#overview">Overview</a>
        <a href="#stock">Stock</a>
        <a href="#price">Price History</a>
        <span class="badge-app badge-app--neutral">Purchase / Shipment / Sales history — later phases</span>
    </div>

    <div id="overview" class="detail-grid">
        <div class="detail-item"><dt>SKU</dt><dd>@Model.Sku</dd></div>
        <div class="detail-item"><dt>Name</dt><dd>@Model.Name</dd></div>
        <div class="detail-item"><dt>Category</dt><dd>@(Model.Category?.Name ?? "—")</dd></div>
        <div class="detail-item"><dt>Brand</dt><dd>@(Model.Brand ?? "—")</dd></div>
        <div class="detail-item"><dt>Vehicle</dt><dd>@(Model.VehicleBrand) @(Model.VehicleModel) @(Model.VariantYear)</dd></div>
        <div class="detail-item"><dt>Unit</dt><dd>@(Model.Unit?.Name ?? "—")</dd></div>
        <div class="detail-item"><dt>Supplier</dt><dd>@(Model.DefaultSupplier?.Name ?? "—")</dd></div>
        <div class="detail-item"><dt>Wholesale</dt><dd>Rs. @Model.WholesalePrice.ToString("N2")</dd></div>
        <div class="detail-item"><dt>Retail</dt><dd>Rs. @Model.RetailPrice.ToString("N2")</dd></div>
        <div class="detail-item"><dt>Min Sale</dt><dd>Rs. @Model.MinimumSalePrice.ToString("N2")</dd></div>
        @if (canViewCosts)
        {
            <div class="detail-item"><dt>Latest RMB</dt><dd>¥ @(Model.LatestRmbPrice?.ToString("N4") ?? "—")</dd></div>
            <div class="detail-item"><dt>Previous RMB</dt><dd>¥ @(Model.PreviousRmbPrice?.ToString("N4") ?? "—")</dd></div>
            <div class="detail-item"><dt>Latest Landed</dt><dd>Rs. @(Model.LatestLandedCost?.ToString("N4") ?? "—")</dd></div>
            <div class="detail-item"><dt>Average Cost</dt><dd>Rs. @(Model.AverageCost?.ToString("N4") ?? "—")</dd></div>
        }
        <div class="detail-item"><dt>CBM</dt><dd>@(Model.Cbm?.ToString("N6") ?? "—")</dd></div>
        <div class="detail-item"><dt>Pcs / Carton</dt><dd>@(Model.PiecesPerCarton?.ToString() ?? "—")</dd></div>
    </div>

    <h3 id="stock" class="card-panel__title">Stock summary</h3>
    <div class="detail-grid">
        <div class="detail-item"><dt>Current Stock</dt><dd>@Model.CurrentStock.ToString("N2")</dd></div>
        <div class="detail-item"><dt>Reorder Level</dt><dd>@Model.ReorderLevel.ToString("N2")</dd></div>
        <div class="detail-item"><dt>Stock Value</dt><dd>Rs. @Model.StockValue.ToString("N2")</dd></div>
    </div>

    @if (canViewCosts)
    {
        <h3 id="price" class="card-panel__title">RMB price history</h3>
        <div class="table-wrap">
            <table class="table-app">
                <thead><tr><th>Date</th><th>RMB</th><th>Source</th><th>Notes</th></tr></thead>
                <tbody>
                @if (Model.RmbPriceHistory.Count == 0)
                {
                    <tr><td colspan="4">No history yet.</td></tr>
                }
                else
                {
                    foreach (var h in Model.RmbPriceHistory)
                    {
                        <tr>
                            <td>@h.EffectiveDate.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td>¥ @h.UnitPriceRmb.ToString("N4")</td>
                            <td>@h.SourceReference</td>
                            <td>@h.Notes</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>

        <h3 class="card-panel__title">Landed cost history</h3>
        <div class="table-wrap">
            <table class="table-app">
                <thead><tr><th>Date</th><th>Landed PKR</th><th>Shipment</th><th>Notes</th></tr></thead>
                <tbody>
                @if (Model.LandedCostHistory.Count == 0)
                {
                    <tr><td colspan="4">No history yet.</td></tr>
                }
                else
                {
                    foreach (var h in Model.LandedCostHistory)
                    {
                        <tr>
                            <td>@h.EffectiveDate.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td>Rs. @h.LandedUnitCostPkr.ToString("N4")</td>
                            <td>@(h.ShipmentReference ?? h.SourceReference)</td>
                            <td>@h.Notes</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    }
</div>
