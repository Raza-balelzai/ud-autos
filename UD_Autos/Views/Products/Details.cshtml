@model ProductDetailsViewModel
@{
    var p = Model.Product;
    var canViewCosts = Model.CanViewCosts;
}

@section PageActions {
    <a class="btn-app btn-app--outline" asp-action="Edit" asp-route-id="@p.Id"><svg class="ico" aria-hidden="true"><use href="#i-pencil"></use></svg> Edit</a>
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@p.Id" />
        @Html.AntiForgeryToken()
        <button type="submit" class="btn-app btn-app--danger" data-confirm="Deactivate this product?"><svg class="ico" aria-hidden="true"><use href="#i-ban"></use></svg> Deactivate</button>
    </form>
}

<div class="card-panel">
    <div class="tabs-app">
        <a class="is-active" href="#overview">Overview</a>
        <a href="#stock">Stock</a>
        <a href="#price">Price History</a>
        <a href="#purchases">Purchases</a>
        <a href="#shipments">Shipments</a>
        <a href="#sales">Sales</a>
    </div>

    <div id="overview">
        <section class="form-section form-section--first">
            <div class="form-section__head">
                <h3 class="form-section__title">Identity</h3>
            </div>
            <div class="product-overview">
                @if (!string.IsNullOrEmpty(p.ImagePath))
                {
                    <button type="button" class="product-photo" data-image-preview="@p.ImagePath" data-image-title="@p.Name" aria-label="Preview @p.Name">
                        <img src="@p.ImagePath" alt="@p.Name" />
                    </button>
                }
                else
                {
                    <div class="product-photo product-photo--empty">No image</div>
                }
                <div class="detail-grid">
                <div class="detail-item"><dt>SKU</dt><dd>@p.Sku</dd></div>
                <div class="detail-item"><dt>Type</dt><dd>@(p.ProductKind == ProductKind.CompleteSet ? "Complete set" : "Single item")</dd></div>
                <div class="detail-item"><dt>Barcode</dt><dd>@(p.Barcode ?? "—")</dd></div>
                <div class="detail-item"><dt>Name</dt><dd>@p.Name</dd></div>
                <div class="detail-item"><dt>Category</dt><dd>@(p.Category?.Name ?? "—")</dd></div>
                <div class="detail-item"><dt>Brand</dt><dd>@(p.Brand ?? "—")</dd></div>
                <div class="detail-item"><dt>Vehicle</dt><dd>@(string.Join(" ", new[] { p.VehicleBrand, p.VehicleModel, p.VariantYear }.Where(x => !string.IsNullOrWhiteSpace(x))))</dd></div>
                <div class="detail-item"><dt>Unit</dt><dd>@(p.Unit?.Name ?? "—")</dd></div>
                <div class="detail-item"><dt>Supplier</dt><dd>@(p.DefaultSupplier?.Name ?? "—")</dd></div>
                </div>
            </div>
        </section>
        <section class="form-section">
            <div class="form-section__head">
                <h3 class="form-section__title">Prices</h3>
            </div>
            <div class="detail-grid">
                <div class="detail-item"><dt>@(p.ProductKind == ProductKind.CompleteSet ? "Set price" : "Wholesale price")</dt><dd>Rs. @p.WholesalePrice.ToString("N2")</dd></div>
                <div class="detail-item"><dt>Retail price</dt><dd>Rs. @p.RetailPrice.ToString("N2")</dd></div>
                <div class="detail-item"><dt>Minimum sale price</dt><dd>Rs. @p.MinimumSalePrice.ToString("N2")</dd></div>
                @if (canViewCosts)
                {
                    <div class="detail-item"><dt>Latest RMB price</dt><dd>¥ @(p.LatestRmbPrice?.ToString("N4") ?? "—")</dd></div>
                    <div class="detail-item"><dt>Previous RMB price</dt><dd>¥ @(p.PreviousRmbPrice?.ToString("N4") ?? "—")</dd></div>
                    <div class="detail-item"><dt>Latest landed cost</dt><dd>Rs. @(p.LatestLandedCost?.ToString("N4") ?? "—")</dd></div>
                    <div class="detail-item"><dt>Average cost</dt><dd>Rs. @(p.AverageCost?.ToString("N4") ?? "—")</dd></div>
                }
            </div>
        </section>
        <section class="form-section">
            <div class="form-section__head">
                <h3 class="form-section__title">Size and weight</h3>
            </div>
            <div class="detail-grid">
                <div class="detail-item"><dt>CBM</dt><dd>@(p.Cbm?.ToString("N6") ?? "—")</dd></div>
                <div class="detail-item"><dt>Pieces per carton</dt><dd>@(p.PiecesPerCarton?.ToString() ?? "—")</dd></div>
            </div>
        </section>
    </div>

    <section id="stock" class="form-section">
    <div class="form-section__head">
        <h3 class="form-section__title">Stock</h3>
    </div>
    @if (p.ProductKind == ProductKind.CompleteSet)
    {
        <div class="detail-grid">
            <div class="detail-item"><dt>Sets available</dt><dd>@((p.VirtualAvailableSets ?? 0).ToString("N0"))</dd></div>
            <div class="detail-item"><dt>Limited by</dt><dd>@(p.LimitingComponentName ?? "—")</dd></div>
        </div>
        <div class="form-section__head"><h3 class="form-section__title">Set items</h3></div>
        <div class="table-wrap">
            <table class="table-app">
                <thead><tr><th>Item</th><th>Required Qty</th><th>Available Stock</th></tr></thead>
                <tbody>
                @if (p.SetComponents.Count == 0)
                {
                    <tr><td colspan="3">No items in this set.</td></tr>
                }
                else
                {
                    foreach (var component in p.SetComponents.Where(c => c.IsActive))
                    {
                        var available = component.ComponentProduct.CurrentStock - component.ComponentProduct.ReservedQuantity;
                        <tr>
                            <td>@component.ComponentProduct.Sku — @component.ComponentProduct.Name</td>
                            <td>@component.RequiredQuantity.ToString("N2")</td>
                            <td>@available.ToString("N2")</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="detail-grid">
            <div class="detail-item"><dt>Current Stock</dt><dd>@p.CurrentStock.ToString("N2")</dd></div>
            <div class="detail-item"><dt>Reorder Level</dt><dd>@p.ReorderLevel.ToString("N2")</dd></div>
            <div class="detail-item"><dt>Stock Value</dt><dd>Rs. @p.StockValue.ToString("N2")</dd></div>
        </div>
    }
    </section>

    @if (canViewCosts)
    {
        <section id="price" class="form-section">
        <div class="form-section__head"><h3 class="form-section__title">RMB price history</h3></div>
        <div class="table-wrap">
            <table class="table-app">
                <thead><tr><th>Date</th><th>RMB</th><th>Source</th><th>Notes</th></tr></thead>
                <tbody>
                @if (p.RmbPriceHistory.Count == 0)
                {
                    <tr><td colspan="4">No history yet.</td></tr>
                }
                else
                {
                    foreach (var h in p.RmbPriceHistory)
                    {
                        <tr>
                            <td>@h.EffectiveDate.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td>¥ @h.UnitPriceRmb.ToString("N4")</td>
                            <td>@h.SourceReference</td>
                            <td>@h.Notes</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>

        <div class="form-section__head"><h3 class="form-section__title">Landed cost history</h3></div>
        <div class="table-wrap">
            <table class="table-app">
                <thead><tr><th>Date</th><th>Landed PKR</th><th>Shipment</th><th>Notes</th></tr></thead>
                <tbody>
                @if (p.LandedCostHistory.Count == 0)
                {
                    <tr><td colspan="4">No history yet.</td></tr>
                }
                else
                {
                    foreach (var h in p.LandedCostHistory)
                    {
                        <tr>
                            <td>@h.EffectiveDate.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td>Rs. @h.LandedUnitCostPkr.ToString("N4")</td>
                            <td>@(h.ShipmentReference ?? h.SourceReference)</td>
                            <td>@h.Notes</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
        </section>
    }
    else
    {
        <section id="price" class="form-section">
            <div class="form-section__head"><h3 class="form-section__title">Price history</h3></div>
            <p class="hint">Cost history is visible to Owner, Manager, and Accountant only.</p>
        </section>
    }

    <section id="purchases" class="form-section">
    <div class="form-section__head"><h3 class="form-section__title">Purchase history</h3></div>
    <div class="table-wrap">
        <table class="table-app">
            <thead>
            <tr>
                <th>PO</th>
                <th>Date</th>
                <th>Supplier</th>
                <th>Qty</th>
                @if (canViewCosts)
                {
                    <th>RMB Unit</th>
                    <th>RMB Total</th>
                }
            </tr>
            </thead>
            <tbody>
            @if (Model.PurchaseHistory.Count == 0)
            {
                <tr><td colspan="@(canViewCosts ? 6 : 4)">No purchase orders yet.</td></tr>
            }
            else
            {
                foreach (var row in Model.PurchaseHistory)
                {
                    <tr>
                        <td><a asp-controller="PurchaseOrders" asp-action="Details" asp-route-id="@row.PurchaseOrderId">@row.PoNumber</a></td>
                        <td>@row.OrderDate.ToString("dd MMM yyyy")</td>
                        <td>@row.SupplierName</td>
                        <td>@row.Quantity.ToString("N2")</td>
                        @if (canViewCosts)
                        {
                            <td>¥ @row.UnitPriceRmb.ToString("N4")</td>
                            <td>¥ @row.LineTotalRmb.ToString("N4")</td>
                        }
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
    </section>

    <section id="shipments" class="form-section">
    <div class="form-section__head"><h3 class="form-section__title">Shipment history</h3></div>
    <div class="table-wrap">
        <table class="table-app">
            <thead>
            <tr>
                <th>Shipment</th>
                <th>Status</th>
                <th>Expected</th>
                <th>Actual</th>
                <th>China WH</th>
                <th>Tarnol</th>
                @if (canViewCosts)
                {
                    <th>Landed Unit</th>
                }
            </tr>
            </thead>
            <tbody>
            @if (Model.ShipmentHistory.Count == 0)
            {
                <tr><td colspan="@(canViewCosts ? 7 : 6)">No shipments yet.</td></tr>
            }
            else
            {
                foreach (var row in Model.ShipmentHistory)
                {
                    <tr>
                        <td><a asp-controller="Shipments" asp-action="Details" asp-route-id="@row.ShipmentId">@row.ShipmentNumber</a></td>
                        <td>@row.Status</td>
                        <td>@row.ExpectedQuantity.ToString("N2")</td>
                        <td>@(row.ActualQuantity?.ToString("N2") ?? "—")</td>
                        <td>@(row.ChinaWarehouseReceivedDate?.ToString("dd MMM yyyy") ?? "—")</td>
                        <td>@(row.TarnolArrivalDate?.ToString("dd MMM yyyy") ?? "—")</td>
                        @if (canViewCosts)
                        {
                            <td>@(row.LandedUnitCostPkr > 0 ? $"Rs. {row.LandedUnitCostPkr:N4}" : "—")</td>
                        }
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
    </section>

    <section id="sales" class="form-section">
    <div class="form-section__head"><h3 class="form-section__title">Sales history</h3></div>
    <div class="table-wrap">
        <table class="table-app">
            <thead>
            <tr>
                <th>Invoice</th>
                <th>Date</th>
                <th>Customer</th>
                <th>Qty</th>
                <th>Price</th>
                <th>Line Total</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.SalesHistory.Count == 0)
            {
                <tr><td colspan="6">No sales yet.</td></tr>
            }
            else
            {
                foreach (var row in Model.SalesHistory)
                {
                    <tr>
                        <td><a asp-controller="Sales" asp-action="Details" asp-route-id="@row.InvoiceId">@row.InvoiceNumber</a></td>
                        <td>@row.InvoiceDate.ToString("dd MMM yyyy")</td>
                        <td>@row.CustomerName</td>
                        <td>@row.Quantity.ToString("N2")</td>
                        <td>Rs. @row.UnitPrice.ToString("N2")</td>
                        <td>Rs. @row.LineTotal.ToString("N2")</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
    </section>
</div>
