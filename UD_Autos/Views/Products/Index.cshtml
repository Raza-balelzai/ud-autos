@model PagedResult<Product>
@{
    var categories = ViewBag.Categories as IReadOnlyList<ProductCategory> ?? Array.Empty<ProductCategory>();
    var pager = PagerViewModel.From(Model, "Index", new
    {
        search = Model.Search,
        sortBy = Model.SortBy,
        sortDesc = Model.SortDesc,
        categoryId = Context.Request.Query["categoryId"].ToString()
    });
}

@section PageActions {
    <a class="btn-app btn-app--primary" asp-action="Create">+ Add Product</a>
}

<div class="card-panel">
    <form method="get" class="table-toolbar">
        <input class="input-app" type="search" name="search" value="@Model.Search" placeholder="Search SKU, name, brand..." />
        <select class="select-app" name="categoryId" asp-items="@(new SelectList(categories, "Id", "Name", Context.Request.Query["categoryId"].ToString()))">
            <option value="">All categories</option>
        </select>
        <select class="select-app" name="sortBy">
            <option value="name" selected="@(Model.SortBy == "name" || string.IsNullOrEmpty(Model.SortBy))">Name</option>
            <option value="sku" selected="@(Model.SortBy == "sku")">SKU</option>
            <option value="stock" selected="@(Model.SortBy == "stock")">Stock</option>
            <option value="price" selected="@(Model.SortBy == "price")">Wholesale</option>
        </select>
        <label class="checkbox-row">
            <input type="checkbox" name="sortDesc" value="true" checked="@Model.SortDesc" /> Desc
        </label>
        <button type="submit" class="btn-app btn-app--outline">Filter</button>
    </form>

    <div class="table-wrap">
        <table class="table-app">
            <thead>
            <tr>
                <th>Image</th>
                <th>SKU</th>
                <th>Product Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Status</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="8"><div class="empty-state">No products yet. Add your first product master record.</div></td></tr>
            }
            else
            {
                foreach (var item in Model.Items)
                {
                    var low = item.ProductKind == ProductKind.CompleteSet
                        ? (item.VirtualAvailableSets ?? 0) <= 0
                        : item.CurrentStock <= item.ReorderLevel;
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImagePath))
                            {
                                <img class="thumb" src="@item.ImagePath" alt="@item.Name" />
                            }
                            else
                            {
                                <span class="badge-app badge-app--neutral">No img</span>
                            }
                        </td>
                        <td>@item.Sku</td>
                        <td>
                            @item.Name
                            @if (item.ProductKind == ProductKind.CompleteSet)
                            {
                                <span class="badge-app badge-app--neutral">Complete set</span>
                            }
                        </td>
                        <td>@(item.Category?.Name ?? "—")</td>
                        <td>Rs. @item.WholesalePrice.ToString("N2")</td>
                        <td>
                            @if (item.ProductKind == ProductKind.CompleteSet)
                            {
                                @((item.VirtualAvailableSets ?? 0).ToString("N0"))
                                @if (!string.IsNullOrEmpty(item.LimitingComponentName))
                                {
                                    <div class="hint">Limited by @item.LimitingComponentName</div>
                                }
                            }
                            else
                            {
                                @item.CurrentStock.ToString("N0")
                            }
                        </td>
                        <td>
                            @if (item.ProductKind == ProductKind.CompleteSet && (item.VirtualAvailableSets ?? 0) <= 0)
                            {
                                <span class="badge-app badge-app--danger">Out of stock</span>
                            }
                            else if (low)
                            {
                                <span class="badge-app badge-app--warning">Low stock</span>
                            }
                            else
                            {
                                <span class="badge-app badge-app--success">In stock</span>
                            }
                        </td>
                        <td class="actions">
                            <a class="btn-app btn-app--outline btn-app--sm" asp-action="Details" asp-route-id="@item.Id">View</a>
                            <a class="btn-app btn-app--outline btn-app--sm" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>

    <partial name="_Pager" model="pager" />
</div>
