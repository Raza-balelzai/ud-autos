@model StockHoldReleaseViewModel
@{
    var mode = (Model.Mode ?? "hold").Equals("release", StringComparison.OrdinalIgnoreCase) ? "release" : "hold";
    var products = ViewBag.Products as IReadOnlyList<UD_Autos.Models.Products.Product> ?? Array.Empty<UD_Autos.Models.Products.Product>();
    var batches = ViewBag.Batches as IReadOnlyList<UD_Autos.Models.Inventory.InventoryBatch> ?? Array.Empty<UD_Autos.Models.Inventory.InventoryBatch>();
}

<form method="post" asp-action="@(mode == "hold" ? "Hold" : "Release")" class="card-panel">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Mode" value="@mode" />

    <p class="hint">
        @(mode == "hold"
            ? "Hold reduces Available for sales without removing physical stock. Use when a customer asks you to keep goods."
            : "Release returns held quantity to Available for sales.")
    </p>
    <p class="form-legend"><span class="req" aria-hidden="true">*</span> Required field</p>

    <div class="form-grid form-grid--3">
        <div class="field">
            <label asp-for="ProductId" class="is-required">Product <span class="req" aria-hidden="true">*</span></label>
            <select asp-for="ProductId" class="select-app" asp-items="@(new SelectList(products, "Id", "Name", Model.ProductId))" onchange="location.href='@(mode == "hold" ? Url.Action("Hold") : Url.Action("Release"))?productId='+this.value" required>
                <option value="0">— Select —</option>
            </select>
        </div>
        <div class="field">
            <label asp-for="BatchId">Batch</label>
            <select asp-for="BatchId" class="select-app">
                <option value="">Product-level only</option>
                @foreach (var b in batches)
                {
                    <option value="@b.Id" selected="@(Model.BatchId == b.Id)">
                        @b.BatchNumber — rem @b.RemainingQuantity.ToString("N2") / reserved @b.ReservedQuantity.ToString("N2")
                    </option>
                }
            </select>
            <span class="hint">Optional</span>
        </div>
        <div class="field">
            <label asp-for="Quantity" class="is-required">Quantity <span class="req" aria-hidden="true">*</span></label>
            <input asp-for="Quantity" class="input-app" required />
        </div>
        <div class="field form-grid--full">
            <label asp-for="Reason" class="is-required">Reason <span class="req" aria-hidden="true">*</span></label>
            <input asp-for="Reason" class="input-app" required />
        </div>
    </div>

    <div class="page-header__actions">
        <button type="submit" class="btn-app btn-app--primary">@(mode == "hold" ? "Hold stock" : "Release stock")</button>
        <a class="btn-app btn-app--outline" asp-action="Index">Cancel</a>
    </div>
</form>
