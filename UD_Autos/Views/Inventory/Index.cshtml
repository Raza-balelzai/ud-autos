@model PagedResult<Product>
@{
    var pager = PagerViewModel.From(Model, "Index", new
    {
        search = Model.Search,
        lowStock = Context.Request.Query["lowStock"].ToString(),
        outOfStock = Context.Request.Query["outOfStock"].ToString()
    });
}

@section PageActions {
    <a class="btn-app btn-app--outline" asp-action="Batches"><svg class="ico" aria-hidden="true"><use href="#i-layers"></use></svg> Batches</a>
    <a class="btn-app btn-app--outline" asp-action="Movements"><svg class="ico" aria-hidden="true"><use href="#i-activity"></use></svg> Movements</a>
    <a class="btn-app btn-app--outline" asp-action="LowStock"><svg class="ico" aria-hidden="true"><use href="#i-alert"></use></svg> Low stock</a>
    <a class="btn-app btn-app--outline" asp-action="Hold"><svg class="ico" aria-hidden="true"><use href="#i-pause"></use></svg> Hold</a>
    <a class="btn-app btn-app--outline" asp-action="Release"><svg class="ico" aria-hidden="true"><use href="#i-play"></use></svg> Release</a>
    <a class="btn-app btn-app--outline" asp-controller="SupplierReturns" asp-action="Index"><svg class="ico" aria-hidden="true"><use href="#i-undo"></use></svg> Supplier returns</a>
    <a class="btn-app btn-app--primary" asp-action="Adjust"><svg class="ico" aria-hidden="true"><use href="#i-pencil"></use></svg> Adjust stock</a>
}

<div class="card-panel">
    <form method="get" class="table-toolbar">
        <input class="input-app" name="search" value="@Model.Search" placeholder="Search SKU / name..." />
        <label class="checkbox-row"><input type="checkbox" name="lowStock" value="true" checked="@((ViewBag.LowStock as bool?) == true)" /> Low stock</label>
        <label class="checkbox-row"><input type="checkbox" name="outOfStock" value="true" checked="@((ViewBag.OutOfStock as bool?) == true)" /> Out of stock</label>
        <button type="submit" class="btn-app btn-app--outline"><svg class="ico" aria-hidden="true"><use href="#i-filter"></use></svg> Filter</button>
    </form>

    <div class="table-wrap">
        <table class="table-app">
            <thead>
            <tr>
                <th>SKU</th>
                <th>Product</th>
                <th>Type</th>
                <th>Current</th>
                <th>Available</th>
                <th>Reserved</th>
                <th>Damaged</th>
                <th>Avg cost</th>
                <th>Latest landed</th>
                <th>Stock value</th>
                <th>Status</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="12"><div class="empty-state">No stock rows. Finalize a shipment to post inventory.</div></td></tr>
            }
            else
            {
                foreach (var p in Model.Items)
                {
                    <tr>
                        <td>@p.Sku</td>
                        <td>
                            @p.Name
                            @if (p.ProductKind == ProductKind.CompleteSet && !string.IsNullOrEmpty(p.LimitingComponentName))
                            {
                                <div class="hint">Limited by @p.LimitingComponentName</div>
                            }
                        </td>
                        <td>@(p.ProductKind == ProductKind.CompleteSet ? "Complete set" : "Single item")</td>
                        <td>@(p.ProductKind == ProductKind.CompleteSet ? "—" : p.CurrentStock.ToString("N2"))</td>
                        <td>@(p.ProductKind == ProductKind.CompleteSet ? (p.VirtualAvailableSets ?? 0).ToString("N0") : p.AvailableQuantity.ToString("N2"))</td>
                        <td>@p.ReservedQuantity.ToString("N2")</td>
                        <td>@p.DamagedStock.ToString("N2")</td>
                        <td>@(User.IsInRole(AppRoles.Salesman) ? "—" : $"Rs. {(p.AverageCost ?? 0):N4}")</td>
                        <td>@(User.IsInRole(AppRoles.Salesman) ? "—" : $"Rs. {(p.LatestLandedCost ?? 0):N4}")</td>
                        <td>@(User.IsInRole(AppRoles.Salesman) ? "—" : $"Rs. {p.StockValue:N2}")</td>
                        <td>
                            @if (p.ProductKind == ProductKind.CompleteSet)
                            {
                                if ((p.VirtualAvailableSets ?? 0) <= 0)
                                {
                                    <span class="badge-app badge-app--danger">Out of stock</span>
                                }
                                else
                                {
                                    <span class="badge-app badge-app--success">In stock</span>
                                }
                            }
                            else if (p.CurrentStock <= 0)
                            {
                                <span class="badge-app badge-app--danger">Out of stock</span>
                            }
                            else if (p.CurrentStock <= p.ReorderLevel)
                            {
                                <span class="badge-app badge-app--warning">Low stock</span>
                            }
                            else
                            {
                                <span class="badge-app badge-app--success">In stock</span>
                            }
                        </td>
                        <td class="actions">
                            <a class="btn-app btn-app--primary btn-app--icon" asp-controller="Products" asp-action="Details" asp-route-id="@p.Id" title="View" aria-label="View"><svg class="ico" aria-hidden="true"><use href="#i-eye"></use></svg></a>
                            <a class="btn-app btn-app--success btn-app--icon" asp-controller="Products" asp-action="Edit" asp-route-id="@p.Id" title="Edit" aria-label="Edit"><svg class="ico" aria-hidden="true"><use href="#i-pencil"></use></svg></a>
                            <form asp-controller="Products" asp-action="Delete" method="post" class="row-action">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@p.Id" />
                                <button type="submit" class="btn-app btn-app--danger btn-app--icon" title="Deactivate" aria-label="Deactivate" onclick="return confirm('Deactivate this product?');"><svg class="ico" aria-hidden="true"><use href="#i-ban"></use></svg></button>
                            </form>
                            @if (p.ProductKind == ProductKind.CompleteSet)
                            {
                                <a class="btn-app btn-app--outline btn-app--icon" asp-controller="Products" asp-action="Details" asp-route-id="@p.Id" title="Set items" aria-label="Set items"><svg class="ico" aria-hidden="true"><use href="#i-box"></use></svg></a>
                            }
                            else
                            {
                                <a class="btn-app btn-app--outline btn-app--icon" asp-action="Batches" asp-route-productId="@p.Id" title="Batches" aria-label="Batches"><svg class="ico" aria-hidden="true"><use href="#i-layers"></use></svg></a>
                                <a class="btn-app btn-app--outline btn-app--icon" asp-action="Hold" asp-route-productId="@p.Id" title="Hold" aria-label="Hold"><svg class="ico" aria-hidden="true"><use href="#i-pause"></use></svg></a>
                                <a class="btn-app btn-app--outline btn-app--icon" asp-action="Release" asp-route-productId="@p.Id" title="Release" aria-label="Release"><svg class="ico" aria-hidden="true"><use href="#i-play"></use></svg></a>
                                <a class="btn-app btn-app--outline btn-app--icon" asp-action="Movements" asp-route-productId="@p.Id" title="Movements" aria-label="Movements"><svg class="ico" aria-hidden="true"><use href="#i-activity"></use></svg></a>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="pager" />
</div>
