@model PagedResult<StockMovement>
@{
    var pager = PagerViewModel.From(Model, "Movements", new
    {
        productId = Context.Request.Query["productId"].ToString(),
        type = Context.Request.Query["type"].ToString(),
        from = Context.Request.Query["from"].ToString(),
        to = Context.Request.Query["to"].ToString()
    });
}

@section PageActions {
    <a class="btn-app btn-app--outline" asp-action="Index">Current stock</a>
}

<div class="card-panel">
    <form method="get" class="table-toolbar">
        <input class="input-app" name="productId" value="@ViewBag.ProductId" placeholder="Product Id" />
        <select class="select-app" name="type" asp-items="Html.GetEnumSelectList<StockMovementType>()"><option value="">All types</option></select>
        <input class="input-app" type="date" name="from" value="@((ViewBag.From as DateTime?)?.ToString("yyyy-MM-dd"))" />
        <input class="input-app" type="date" name="to" value="@((ViewBag.To as DateTime?)?.ToString("yyyy-MM-dd"))" />
        <button type="submit" class="btn-app btn-app--outline">Filter</button>
    </form>

    <div class="table-wrap">
        <table class="table-app">
            <thead>
            <tr>
                <th>When</th>
                <th>SKU</th>
                <th>Type</th>
                <th>Qty</th>
                <th>After</th>
                <th>Unit cost</th>
                <th>Reference</th>
                <th>Reason</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var m in Model.Items)
            {
                <tr>
                    <td>@m.OccurredAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                    <td>@m.Product.Sku</td>
                    <td><span class="badge-app badge-app--neutral">@(m.MovementType == StockMovementType.SetConsumption ? "Set sale" : m.MovementType.ToString())</span></td>
                    <td>@m.Quantity.ToString("N2")</td>
                    <td>@m.QuantityAfter.ToString("N2")</td>
                    <td>Rs. @m.UnitCostPkr.ToString("N4")</td>
                    <td>@(m.ReferenceNumber ?? m.ReferenceType)</td>
                    <td>@m.Reason</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="pager" />
</div>
