@model IReadOnlyList<InventoryBatch>

@section PageActions {
    <a class="btn-app btn-app--outline" asp-action="Index"><svg class="ico" aria-hidden="true"><use href="#i-arrow-left"></use></svg> Current stock</a>
    <a class="btn-app btn-app--outline" asp-action="Damage" asp-route-productId="@ViewBag.ProductId"><svg class="ico" aria-hidden="true"><use href="#i-alert"></use></svg> Mark damaged</a>
}

<div class="card-panel">
    <form method="get" class="table-toolbar">
        <input type="hidden" name="productId" value="@ViewBag.ProductId" />
        <input class="input-app" name="search" value="@Context.Request.Query["search"]" placeholder="Batch / SKU / shipment..." />
        <button type="submit" class="btn-app btn-app--outline"><svg class="ico" aria-hidden="true"><use href="#i-filter"></use></svg> Filter</button>
    </form>

    <div class="table-wrap">
        <table class="table-app">
            <thead>
            <tr>
                <th>Batch</th>
                <th>SKU</th>
                <th>Shipment</th>
                <th>Received</th>
                <th>Remaining</th>
                <th>Reserved</th>
                <th>Damaged</th>
                <th>Landed unit</th>
                <th>Received at</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="10"><div class="empty-state">No batches yet.</div></td></tr>
            }
            else
            {
                foreach (var b in Model)
                {
                    <tr>
                        <td>@b.BatchNumber</td>
                        <td>@b.Product.Sku</td>
                        <td>@b.Shipment.ShipmentNumber</td>
                        <td>@b.ReceivedQuantity.ToString("N2")</td>
                        <td>@b.RemainingQuantity.ToString("N2")</td>
                        <td>@b.ReservedQuantity.ToString("N2")</td>
                        <td>@b.DamagedQuantity.ToString("N2")</td>
                        <td>Rs. @b.LandedUnitCostPkr.ToString("N4")</td>
                        <td>@b.ReceivedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                        <td class="actions">
                            <a class="btn-app btn-app--outline btn-app--sm" asp-action="Hold" asp-route-productId="@b.ProductId" asp-route-batchId="@b.Id"><svg class="ico" aria-hidden="true"><use href="#i-pause"></use></svg> Hold</a>
                            <a class="btn-app btn-app--outline btn-app--sm" asp-action="Release" asp-route-productId="@b.ProductId" asp-route-batchId="@b.Id"><svg class="ico" aria-hidden="true"><use href="#i-play"></use></svg> Release</a>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
